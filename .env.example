# Скопировать в .env (или задать в переменных окружения хостинга)
# Секреты никогда не должны попадать в репозиторий.

# URL Cloudflare Worker-релея, который пересылает сообщения в Telegram
# (см. cloudflare/telegram-relay-worker.js) — используется вместо
# прямого обращения к api.telegram.org, т.к. из РФ-хостинга оно
# блокируется на уровне магистральных каналов.
TELEGRAM_RELAY_URL=

# Общий секрет, которым сервер аутентифицируется перед Worker'ом
# (совпадает с RELAY_SECRET в настройках Worker'а)
TELEGRAM_RELAY_SECRET=
