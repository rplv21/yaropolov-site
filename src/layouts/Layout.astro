---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import EasterEgg from '../components/EasterEgg.astro';
import ChapterRail from '../components/ChapterRail.astro';
import StatusReadout from '../components/StatusReadout.astro';
import CursorGrid from '../components/CursorGrid.astro';
import LoadScreen from '../components/LoadScreen.astro';
import AdPopup from '../components/AdPopup.astro';
import FooterDude from '../components/FooterDude.astro';
import { contacts } from '../data/site';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  showChapterRail?: boolean;
}

const { title, description, noindex = false, showChapterRail = true } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og-cover.png', Astro.site);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: contacts.name,
  jobTitle: 'Интернет-маркетолог',
  url: 'https://yaropolov.ru',
  telephone: contacts.phone,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Ярославль',
    addressCountry: 'RU',
  },
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Настройка и ведение контекстной рекламы, создание сайтов',
  provider: {
    '@type': 'Person',
    name: contacts.name,
  },
  areaServed: ['Ярославль', 'Иваново', 'Владимир', 'Кострома', 'Тверь', 'Вологда'],
};

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'Ярополов Павел — интернет-маркетолог',
  image: ogImage.toString(),
  telephone: contacts.phone,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Ярославль',
    addressRegion: 'Ярославская область',
    addressCountry: 'RU',
  },
  areaServed: 'Ярославль и область',
};
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="ru_RU" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />

    <!-- Яндекс.Метрика: согласие на обработку cookie подразумевается -->
    <!-- использованием сайта (см. сноску в футере). -->
    <script is:inline>
      (function(m,e,t,r,i,k,a){
        m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
        m[i].l=1*new Date();
        for (var j = 0; j < document.scripts.length; j++) {if (document.scripts[j].src === r) { return; }}
        k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)
      })(window, document,'script','https://mc.yandex.ru/metrika/tag.js?id=112339088', 'ym');

      ym(112339088, 'init', {ssr:true, webvisor:true, clickmap:true, ecommerce:"dataLayer", referrer: document.referrer, url: location.href, accurateTrackBounce:true, trackLinks:true});
    </script>
    <noscript><div><img src="https://mc.yandex.ru/watch/112339088" style="position:absolute; left:-9999px;" alt="" /></div></noscript>
    <slot name="head" />
  </head>
  <body>
    <LoadScreen />
    <svg class="sr-only" aria-hidden="true" focusable="false">
      <filter id="duotone-red" color-interpolation-filters="sRGB">
        <feColorMatrix
          type="matrix"
          values="0.33 0.33 0.33 0 0
                  0.33 0.33 0.33 0 0
                  0.33 0.33 0.33 0 0
                  0    0    0    1 0"
        />
        <feComponentTransfer>
          <feFuncR type="table" tableValues="0.49 0.96" />
          <feFuncG type="table" tableValues="0.067 0.94" />
          <feFuncB type="table" tableValues="0.098 0.88" />
        </feComponentTransfer>
      </filter>
    </svg>
    <div class="margin-guides" aria-hidden="true">
      <span></span>
      <span></span>
    </div>
    <CursorGrid />
    <EasterEgg />
    {showChapterRail && <ChapterRail />}
    <StatusReadout />
    <AdPopup />
    <FooterDude />
    <div class="page-content">
      <a href="#main" class="sr-only">Перейти к содержимому</a>
      <Header />
      <main id="main">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
