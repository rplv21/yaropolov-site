---
// Обёртка юридических страниц: тёмная шапка с заголовком, текст на бумаге.
import AvLayout from '../../layouts/AvLayout.astro';
interface Props { title: string; description: string; }
const { title, description } = Astro.props;
---

<AvLayout title={`${title} — yaropolov.ru`} description={description} noChat>
  <header class="lg-h">
    <div class="wrap">
      <p class="mono lg-tag">Документы сайта</p>
      <h1 class="lg-t">{title}</h1>
      <nav class="mono lg-nav" aria-label="Документы">
        <a href="/privacy" aria-current={Astro.url.pathname.startsWith('/privacy') ? 'page' : undefined}>Политика</a>
        <a href="/soglasie" aria-current={Astro.url.pathname.startsWith('/soglasie') ? 'page' : undefined}>Согласие</a>
      </nav>
    </div>
  </header>
  <div class="lg-b">
    <div class="wrap lg-in"><slot /></div>
  </div>
</AvLayout>

<style>
  .lg-h {
    padding-top: calc(var(--mast) + clamp(40px, 6vw, 96px));
    padding-bottom: clamp(32px, 5vw, 64px);
  }
  .lg-tag { color: #45413d; }
  .lg-t {
    margin-top: clamp(14px, 2vw, 28px);
    max-width: 16ch;
    font-family: var(--f-display);    font-weight: var(--display-w);
    font-size: clamp(36px, 6vw, 96px);
    letter-spacing: -0.05em;
    line-height: 1;
  }
  .lg-nav { display: flex; gap: 24px; margin-top: clamp(24px, 3vw, 40px); }
  .lg-nav a { color: #45413d; border-bottom: 1px solid transparent; padding-bottom: 2px; position: relative; }
  /* зона нажатия не меньше 24 px, вёрстка не сдвигается */
  .lg-nav a::after { content: ''; position: absolute; inset: -6px -4px; }
  .lg-nav a[aria-current='page'] { color: var(--paper); border-color: var(--red); }
  .lg-b {
    background: #e8e2d6;
    --dim: #6b655b;
    color: var(--paper);
    border-top: 1px solid rgba(18, 17, 16, 0.18);
    padding-block: clamp(40px, 6vw, 96px) clamp(64px, 8vw, 140px);
  }
  /* ~70 знаков в строке при 16 px Montserrat Alternates */
  .lg-in { max-width: 680px; }
  .lg-in :global(.legal-body) { display: grid; gap: 14px; }
  .lg-in :global(.legal-date) { font-family: var(--mono); font-size: 13px; color: #5e5850; }
  .lg-in :global(h2) {
    margin-top: 28px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--line);
    font-family: var(--f-display);
    font-weight: var(--display-w);
    font-size: clamp(22px, 2.4vw, 32px);
    letter-spacing: -0.03em;
    line-height: 1.15;
  }
  .lg-in :global(h3) { margin-top: 12px; font-weight: 500; font-size: 17px; }
  .lg-in :global(p) { font-size: 16px; line-height: 1.6; }
  .lg-in :global(a) { color: #b81d28; border-bottom: 1px solid currentColor; overflow-wrap: anywhere; }
  .lg-in :global(code) { font-family: var(--mono); font-size: 0.9em; }
</style>
