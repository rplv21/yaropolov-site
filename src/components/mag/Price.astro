---
import { services } from '../../data/brand';
---

<section class="sec" id="services" aria-labelledby="price-title">
  <div class="row">
    <p class="lab">Услуги</p>
    <div class="body">
      <h2 id="price-title" class="h2 rise">Что я предлагаю и сколько это стоит</h2>

      <ul class="price-list">
        {services.map((s) => (
          <li class:list={['item', { 'item--feat': s.featured }]}>
            <div class="item-head">
              <p class="small muted">{s.category}</p>
              <h3 class="h3 item-name">{s.name}</h3>
            </div>
            <ul class="item-list small">
              {s.items.map((it) => <li>{it}</li>)}
            </ul>
            <div class="item-end">
              <p class="item-price">{s.price}</p>
              <a href="#contact" class="link small" aria-label={`Обсудить: ${s.name}`}>Обсудить</a>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .price-list {
    margin-top: clamp(28px, 4vw, 56px);
    border-top: 1px solid var(--rule);
  }

  .item {
    display: grid;
    gap: 14px;
    padding-block: clamp(22px, 2.6vw, 36px);
    border-bottom: 1px solid var(--hair);
  }

  @media (min-width: 1000px) {
    .item {
      grid-template-columns: 4fr 5fr 3fr;
      column-gap: var(--gap);
      align-items: start;
    }
  }

  .item-name {
    margin-top: 6px;
    font-size: clamp(22px, 2.4vw, 40px);
    letter-spacing: -0.04em;
  }

  .item--feat .item-name {
    color: var(--red);
  }

  .item-list {
    display: grid;
    gap: 6px;
  }

  .item-list li {
    position: relative;
    padding-left: 18px;
  }

  .item-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 8px;
    height: 1px;
    background: var(--ink);
  }

  .item-end {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 24px;
  }

  @media (min-width: 1000px) {
    .item-end {
      flex-direction: column;
      align-items: flex-end;
    }
  }

  .item-price {
    font-size: clamp(18px, 1.6vw, 26px);
    font-weight: 500;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
</style>
