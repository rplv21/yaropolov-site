---
import { Picture } from 'astro:assets';
import pavel3 from '../assets/p2.jpeg';
import { contacts } from '../data/site';
---

<section class="section section-gap" id="about">
  <div class="about-grid">
    <div class="about-photo panel">
      <div class="about-photo-layer about-photo-sharp">
        <Picture
          src={pavel3}
          formats={['webp']}
          fallbackFormat="jpeg"
          alt="Ярополов Павел Алексеевич, интернет-маркетолог"
          width={640}
          height={800}
          class="about-photo-img"
          loading="lazy"
        />
      </div>
      <div class="about-photo-layer about-photo-blur">
        <Picture
          src={pavel3}
          formats={['webp']}
          fallbackFormat="jpeg"
          alt=""
          aria-hidden="true"
          width={640}
          height={800}
          class="about-photo-img about-photo-img-blur"
          loading="lazy"
        />
      </div>
      <div class="about-photo-layer about-photo-edge">
        <Picture
          src={pavel3}
          formats={['webp']}
          fallbackFormat="jpeg"
          alt=""
          aria-hidden="true"
          width={640}
          height={800}
          class="about-photo-img"
          loading="lazy"
        />
      </div>
      <div class="about-photo-grain" aria-hidden="true"></div>
    </div>

    <div class="about-copy">
      <div class="about-header">
        <p class="mono-label">Обо мне</p>
        <h2 class="about-title">{contacts.shortName}</h2>
        <p class="mono-label about-role">Маркетолог-директолог</p>
      </div>

      <div class="about-text">
        <p>
          В маркетинге больше 5 лет. Начинал с SMM, SEO и PR, сейчас основная специализация —
          интернет-продвижение: Яндекс.Директ и создание сайтов. Для клиентов, с которыми уже есть
          деловые отношения, веду консультации по продвижению бренда, SMM и PR-деятельности.
        </p>
        <p class="about-pull-quote">«Работаю самостоятельно, без агентства»</p>
        <p>
          Это значит, что с кампанией и с сайтом я работаю индивидуально, без сторонних
          помощников, специалистов и лишних наценок.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
  }

  @media (min-width: 900px) {
    .about-grid {
      grid-template-columns: 0.8fr 1.2fr;
      gap: 64px;
      align-items: stretch;
    }

    .about-copy {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }
  }

  .about-photo {
    position: relative;
    aspect-ratio: 4 / 5;
    max-width: 380px;
    overflow: hidden;
    padding: 0;
  }

  /* Маска и фильтр намеренно на разных элементах — так же, как в Hero —
     иначе наложение mask-image и filter на один узел иногда не
     прорисовывается при первом заходе на страницу (баг части браузеров
     на Chromium). */
  .about-photo-layer {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .about-photo-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: url(#photo-mono) contrast(1.1);
  }

  .about-photo-img-blur {
    filter: url(#photo-mono) contrast(1.1);
  }

  .about-photo-sharp {
    -webkit-mask-image: radial-gradient(ellipse 72% 88% at 50% 40%, black 0%, black 64%, transparent 87%), linear-gradient(to top, black 0%, black 5%, transparent 24%);
    mask-image: radial-gradient(ellipse 72% 88% at 50% 40%, black 0%, black 64%, transparent 87%), linear-gradient(to top, black 0%, black 5%, transparent 24%);
  }

  .about-photo-blur {
    -webkit-mask-image: radial-gradient(ellipse 72% 82% at 50% 38%, transparent 0%, transparent 58%, black 72%, black 84%, transparent 96%);
    mask-image: radial-gradient(ellipse 72% 82% at 50% 38%, transparent 0%, transparent 58%, black 72%, black 84%, transparent 96%);
  }

  .about-photo-edge {
    -webkit-mask-image: linear-gradient(to top, black 0%, black 6%, transparent 16%);
    mask-image: linear-gradient(to top, black 0%, black 6%, transparent 16%);
  }

  .about-photo-grain {
    position: absolute;
    inset: 0;
    filter: url(#photo-grain);
    mix-blend-mode: overlay;
    opacity: 0.22;
    pointer-events: none;
  }

  .about-title {
    font-size: 32px;
    margin-top: 12px;
  }

  .about-role {
    margin-top: 10px;
    font-size: 16px;
    letter-spacing: 0.06em;
  }

  .about-role::before {
    display: none;
  }

  @media (min-width: 640px) {
    .about-title {
      font-size: 40px;
    }
  }

  .about-text {
    margin-top: 28px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .about-text p {
    font-size: 17px;
    line-height: 1.6;
    color: var(--color-text-muted);
    max-width: 620px;
  }

  .about-pull-quote {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 26px;
    letter-spacing: -0.01em;
    color: var(--color-text) !important;
    border-left: 2px solid var(--color-accent);
    padding-left: 20px;
    max-width: 520px !important;
  }
</style>
