---
import { case1, case2, case3, hall } from '../../data/brand';

// Кейсы: три блока друг под другом, светлый — тёмный — светлый.
// В каждом только главное: что за проект, одна строка контекста и крупная инфографика
// с двумя-тремя самыми красноречивыми цифрами. Полные списки работ остались в data/site.ts.
const hallCols = 33;
const hallRows = Math.ceil(hall.total / hallCols);
const fullDays = hall.days.filter((d) => d.booked !== null && d.booked >= hall.total).length;

const budget = case2.statsRow1.find((s) => /бюджет/i.test(s.label))?.num ?? 100000;
const revenue = case2.statsRow2.find((s) => /выручк/i.test(s.label))?.num ?? 170000;
const fmt = (n: number) => n.toLocaleString('ru-RU').replace(/\s/g, ' ');

// Иллюстративная форма кривой роста: без осей и значений, цифра стоит рядом
const rise = 'M4,170 C120,172 220,140 330,112 S520,52 696,10';
---

<section class="cases" id="cases" aria-labelledby="cases-title">
  <div class="wrap cases-head">
    <p class="mono tag">Кейсы</p>
    <h2 id="cases-title" class="giant cases-h" data-split>Три проекта, <em>разобранных</em> подробно</h2>
  </div>

  <div class="wrap case-list">
    <!-- Кейс 1. NDA: имя заказчика и число обращений не раскрываются -->
    <article class="case case--light" aria-labelledby="case1-title">
      <div class="case-text">
        <p class="mono case-meta">{case1.label} · {case1.period}</p>
        <h3 id="case1-title" class="case-title">{case1.title}</h3>
        <p class="case-ctx">Поиск и РСЯ по пяти товарным направлениям, реклама на 50+ регионов.</p>
      </div>
      <figure class="case-fig">
        <p class="case-big red" data-count>+{case1.growth.value}%</p>
        <figcaption class="case-big-l">рост обращений с сентября 2025</figcaption>
        <svg class="trend" viewBox="0 0 700 180" aria-hidden="true" focusable="false">
          <line class="t-base" x1="0" y1="176" x2="700" y2="176" />
          <path class="t-line" d={rise} pathLength="1" />
          <circle class="t-dot" cx="696" cy="10" r="7" />
        </svg>
        <dl class="case-kpi">
          <div><dt class="mono">Бюджет в месяц</dt><dd data-count>1 000 000 ₽</dd></div>
          <div><dt class="mono">Регионов</dt><dd>50+</dd></div>
        </dl>
      </figure>
    </article>

    <article class="case case--dark" aria-labelledby="case2-title">
      <div class="case-text">
        <p class="mono case-meta">{case2.label} · {case2.period}</p>
        <h3 id="case2-title" class="case-title">{case2.title}</h3>
        <p class="case-ctx">Платной рекламы не было вообще. Запустил Директ с нуля и настроил учёт покупок билетов.</p>
      </div>
      <figure class="case-fig">
        <p class="case-big red" data-count>{case2.headline[1].num}%</p>
        <figcaption class="case-big-l">окупаемость рекламы: на каждый вложенный рубль — 1,7 рубля выручки</figcaption>
        <div class="cmp" aria-label={`Вложено ${fmt(budget)} ₽, выручка ${fmt(revenue)} ₽`}>
          <div class="cmp-row">
            <span class="mono cmp-l">Вложено в рекламу</span>
            <span class="cmp-bar"><i style={`width:${(budget / revenue) * 100}%`}></i></span>
            <span class="cmp-v">{fmt(budget)} ₽</span>
          </div>
          <div class="cmp-row cmp-row--hot">
            <span class="mono cmp-l">Выручка</span>
            <span class="cmp-bar"><i style="width:100%"></i></span>
            <span class="cmp-v">{fmt(revenue)} ₽</span>
          </div>
        </div>
        <dl class="case-kpi">
          <div><dt class="mono">{case2.headline[0].label}</dt><dd data-count>{case2.headline[0].num}</dd></div>
        </dl>
      </figure>
    </article>

    <article class="case case--light" aria-labelledby="case3-title">
      <div class="case-text">
        <p class="mono case-meta">{case3.label} · {case3.period}</p>
        <h3 id="case3-title" class="case-title">Сайт фестиваля «Русский костюм» с&nbsp;собственной билетной системой</h3>
        <p class="case-ctx">Бронь по схеме зала, PDF-билет, панель администратора и реклама в Директе.</p>
      </div>
      <figure class="case-fig">
        <p class="case-big red" data-count>{case3.big}</p>
        <figcaption class="case-big-l">{case3.bigLabel}</figcaption>
        <div class="occ">
          <canvas
            class="occ-canvas"
            data-total={hall.total}
            data-booked={hall.days[0].booked ?? 0}
            data-cols={hallCols}
            style={`aspect-ratio: ${hallCols} / ${hallRows}`}
            role="img"
            aria-label={`Схема зала: занято ${hall.days[0].booked ?? 0} из ${hall.total} мест`}
          ></canvas>
          <p class="mono occ-l">{fullDays === hall.days.length ? `Оба дня — полный зал, ${hall.total} из ${hall.total} мест` : `${hall.total} мест в зале`}</p>
        </div>
      </figure>
    </article>
  </div>
</section>

<style>
  .cases {
    background: var(--ink-2);
    color: var(--paper);
    /* на #e8e2d6 нужен чуть темнее, чтобы мелкие подписи прошли AA */
    --dim: #5f5950;
    padding-block: clamp(72px, 10vw, 160px);
  }

  .cases-h {
    margin-top: clamp(20px, 3vw, 40px);
    max-width: 14ch;
    font-size: clamp(44px, 8.4vw, 160px);
  }

  .cases-h :global(em) {
    color: var(--red);
  }

  .case-list {
    display: grid;
    gap: 0;
    margin-top: clamp(40px, 6vw, 88px);
  }

  .case {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(32px, 5vw, 96px);
    align-items: center;
    padding: clamp(32px, 5vw, 80px);
  }

  .case--light {
    background: var(--ink);
    color: var(--paper);
    --dim: #6b655b;
  }

  .case--dark {
    background: var(--paper);
    color: var(--ink);
    --dim: #a49d8a;
    --red: #ff2b36;
    --line: rgba(242, 237, 228, 0.2);
  }

  .case-meta {
    color: var(--dim);
  }

  .case-title {
    margin-top: 16px;
    font-family: var(--f-display);
    font-weight: var(--display-w);
    font-size: clamp(26px, 2.6vw, 42px);
    line-height: 1.08;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .case-ctx {
    margin-top: 18px;
    max-width: 40ch;
    font-size: 16px;
    line-height: 1.55;
    color: var(--dim);
  }

  .case-fig {
    margin: 0;
    min-width: 0;
  }

  .case-big {
    font-family: var(--f-display);
    font-weight: var(--display-w);
    font-size: clamp(72px, 10vw, 168px);
    line-height: 0.9;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }

  .case-big.red {
    color: var(--red);
  }

  .case-big-l {
    margin-top: 14px;
    max-width: 36ch;
    font-size: 16px;
    line-height: 1.45;
  }

  .trend {
    display: block;
    width: 100%;
    height: auto;
    margin-top: clamp(24px, 3vw, 40px);
    overflow: visible;
  }

  .t-base {
    stroke: currentColor;
    stroke-opacity: 0.25;
  }

  .t-line {
    fill: none;
    stroke: var(--red);
    stroke-width: 3;
    stroke-dasharray: 1;
    stroke-linecap: round;
  }

  .t-dot {
    fill: var(--red);
  }

  .case-kpi {
    display: flex;
    flex-wrap: wrap;
    gap: 12px clamp(28px, 4vw, 64px);
    margin: clamp(24px, 3vw, 36px) 0 0;
    padding-top: 18px;
    border-top: 1px solid var(--line);
  }

  .case-kpi dt {
    color: var(--dim);
  }

  .case-kpi dd {
    margin: 6px 0 0;
    font-family: var(--f-display);
    font-weight: var(--display-w);
    font-size: clamp(24px, 2.4vw, 36px);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  /* Сравнение «вложено / выручка» */
  .cmp {
    display: grid;
    gap: 14px;
    margin-top: clamp(24px, 3vw, 40px);
  }

  .cmp-row {
    display: grid;
    grid-template-columns: 9.5em minmax(0, 1fr) 7.5em;
    gap: 16px;
    align-items: center;
  }

  .cmp-l {
    color: var(--dim);
  }

  .cmp-bar {
    position: relative;
    height: 18px;
  }

  .cmp-bar i {
    position: absolute;
    inset: 0 auto 0 0;
    background: currentColor;
    opacity: 0.35;
    transform-origin: left center;
  }

  .cmp-row--hot .cmp-bar i {
    background: var(--red);
    opacity: 1;
  }

  .cmp-v {
    text-align: right;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  /* Схема зала */
  .occ {
    margin-top: clamp(24px, 3vw, 40px);
  }

  .occ-canvas {
    display: block;
    width: 100%;
    color: var(--paper);
  }

  .case--dark .occ-canvas {
    color: var(--ink);
  }

  .occ-l {
    margin-top: 12px;
    color: var(--dim);
  }

  @media (max-width: 899px) {
    .case {
      grid-template-columns: minmax(0, 1fr);
    }

    .cmp-row {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .cmp-bar {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }
</style>
