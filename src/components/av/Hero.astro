---
import { cover, heroStats } from '../../data/brand';

// Только то, что реально есть на сайте: услуги и ниши
const items = [
  'Яндекс.Директ',
  'Сайты для бизнеса',
  'Яндекс.Метрика',
  'Таргет ВКонтакте',
  'SEO',
  'Розничная торговля',
  'Услуги для бизнеса',
  'Производство',
  'Строительство и ремонт',
  'Культура и события',
  'Медицина и красота',
];
---

<section class="hero" id="top">
  <canvas class="hero-canvas" aria-hidden="true"></canvas>

  <div class="hero-in wrap">
    <h1 class="giant hero-h">
      Настраиваю<br />Яндекс.Директ<br />и создаю сайты,<br /><span class="red">которые продают</span>
    </h1>

    <div class="hero-row">
      <p class="hero-sub hero-fade">{cover.sub}</p>
      <div class="hero-cta hero-fade">
        <a href="#contact" class="btn btn--red" data-mag>Получить медиаплан</a>
        <a href="#cases" class="btn" data-mag>Смотреть кейсы</a>
      </div>
    </div>
  </div>

  <div class="ticker hero-fade" aria-label="Услуги и ниши">
    <div class="ticker-track">
      {[0, 1].map((copy) => (
        <ul class="ticker-list" aria-hidden={copy === 1 ? 'true' : undefined}>
          {items.map((it) => <li class="mono">{it}</li>)}
        </ul>
      ))}
    </div>
  </div>
</section>

<section class="figs" aria-label="Коротко в цифрах">
  <ul class="wrap figs-row">
    {heroStats.map((s) => (
      <li>
        <p class="fig-n" data-count={s.value.includes('лет') ? undefined : ''}>{s.value}</p>
        <p class="mono dim">{s.label}</p>
      </li>
    ))}
  </ul>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 100dvh;
    padding-top: calc(var(--mast) + 24px);
    overflow: clip;
  }

  .hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero-in {
    position: relative;
    z-index: 1;
    width: 100%;
    display: grid;
    gap: clamp(20px, 3vw, 40px);
    margin-top: clamp(32px, 6vw, 112px);
    padding-bottom: clamp(32px, 5vw, 72px);
  }

  .hero-h {
    font-size: clamp(40px, 10.2vw, 196px);
    visibility: hidden;
  }

  .hero-row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 28px 48px;
  }

  .hero-sub {
    font-size: clamp(17px, 1.4vw, 22px);
    white-space: pre-line;
    line-height: 1.4;
    color: #cfc8b4;
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .js .hero-fade {
    opacity: 0;
    visibility: hidden;
  }

  /* Бегущая строка: единственная на странице */
  .ticker {
    position: relative;
    z-index: 1;
    overflow: hidden;
    border-block: 1px solid var(--line);
    background: var(--ink);
  }

  .ticker-track {
    display: flex;
    width: max-content;
    animation: tick 60s linear infinite;
  }

  .ticker:hover .ticker-track {
    animation-play-state: paused;
  }

  .ticker-list {
    display: flex;
    flex-shrink: 0;
  }

  .ticker-list li {
    display: flex;
    align-items: center;
    padding-block: 18px;
    white-space: nowrap;
  }

  .ticker-list li::after {
    content: '';
    width: 8px;
    height: 8px;
    margin-inline: 32px;
    background: var(--red);
    flex-shrink: 0;
  }

  @keyframes tick {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ticker-track {
      animation: none;
    }
  }

  .figs {
    background: var(--ink);
    border-bottom: 1px solid var(--line);
  }

  .figs-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 800px) {
    .figs-row {
      grid-template-columns: repeat(3, max-content);
      justify-content: space-between;
    }
  }

  .figs-row li {
    padding-block: clamp(24px, 3vw, 48px);
  }

  .fig-n {
    font-weight: 200;
    font-size: clamp(44px, 6.4vw, 120px);
    letter-spacing: -0.06em;
    line-height: 1;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
    margin-bottom: 10px;
  }
</style>
