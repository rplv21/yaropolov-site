---
import { report } from '../../data/brand';
---

<section class="mani" aria-label="Принцип работы">
  <div class="wrap">
    <p class="mono tag">Принцип</p>
    <p class="giant mani-big" data-lit>
      {report.bold} Ни один рубль бюджета не проходит мимо отчёта.
    </p>
    <p class="mani-note">{report.text}</p>
  </div>
</section>

<style>
  .mani {
    background: var(--red);
    color: var(--ink);
    padding-block: clamp(72px, 11vw, 190px);
  }

  .mani .tag {
    color: var(--ink);
  }

  .mani .tag::before {
    background: var(--ink);
  }

  .mani-big {
    margin-top: clamp(28px, 4vw, 64px);
    font-size: clamp(32px, 6.6vw, 124px);
    letter-spacing: -0.055em;
    line-height: 1;
    text-wrap: balance;
  }

  .mani-note {
    margin-top: clamp(32px, 5vw, 80px);
    max-width: 60ch;
    margin-left: auto;
    font-size: clamp(16px, 1.25vw, 20px);
    line-height: 1.55;
  }

  @media (max-width: 899px) {
    .mani-note {
      margin-left: 0;
    }
  }
</style>
