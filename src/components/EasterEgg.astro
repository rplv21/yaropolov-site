<div id="easter-egg-layer" aria-hidden="true"></div>

<style is:global>
  /* Дочерние элементы пасхалки создаются в рантайме через createElement/innerHTML,
     поэтому стили должны быть глобальными — Astro не скоупит динамически созданный DOM. */
  #easter-egg-layer {
    position: fixed;
    inset: 0;
    z-index: 60;
    pointer-events: none;
  }

  .bullseye-egg {
    position: absolute;
    width: 120px;
    height: 120px;
    transform: translate(-50%, -50%);
    animation: egg-pop-fade 1.3s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
  }

  @keyframes egg-pop-fade {
    0% {
      opacity: 0;
      transform: translate(-50%, -50%) scale(0.4) rotate(var(--egg-angle));
    }
    15% {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1.15) rotate(var(--egg-angle));
    }
    25% {
      transform: translate(-50%, -50%) scale(1) rotate(var(--egg-angle));
    }
    75% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translate(-50%, -50%) scale(1) rotate(var(--egg-angle));
    }
  }
</style>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const isMobile = window.innerWidth < 768;

  if (!reduceMotion && !isMobile) {
    const layer = document.getElementById('easter-egg-layer');
    const interactiveSelector = 'a, button, input, select, textarea, label, [role="button"], [tabindex]';

    // Редкая пасхалка: 1% кликов по фону превращаются в выстрел "в яблочко".
    const HIT_CHANCE = 0.01;
    const TOTAL_LIFETIME_MS = 1300;

    let eggCounter = 0;

    function spawnBullseye(x: number, y: number) {
      if (!layer) return;

      const angle = Math.random() * 90 - 45; // не более 45° в любую сторону — мишень не переворачивается

      const wrap = document.createElement('div');
      wrap.className = 'bullseye-egg';
      wrap.style.left = `${x}px`;
      wrap.style.top = `${y}px`;
      wrap.style.setProperty('--egg-angle', `${angle}deg`);

      const arcId = `egg-arc-${eggCounter++}`;

      wrap.innerHTML = `
        <svg viewBox="0 0 160 150" width="100%" height="100%">
          <defs>
            <path id="${arcId}" d="M23,120 A70,70 0 0,0 137,120" fill="none" />
          </defs>
          <circle cx="80" cy="80" r="55" fill="var(--color-text)" />
          <circle cx="80" cy="80" r="44" fill="var(--color-accent)" />
          <circle cx="80" cy="80" r="33" fill="var(--color-text)" />
          <circle cx="80" cy="80" r="22" fill="var(--color-accent)" />
          <circle cx="80" cy="80" r="11" fill="var(--color-text)" />
          <circle cx="80" cy="80" r="5" fill="var(--color-accent)" />
          <line x1="20" y1="80" x2="70" y2="80" stroke="var(--color-canvas)" stroke-width="11" stroke-linecap="round" />
          <path d="M66 68 L90 80 L66 92 Z" fill="var(--color-canvas)" />
          <text
            font-family="var(--font-condensed)"
            font-weight="600"
            font-size="16"
            letter-spacing="0.05em"
            fill="var(--color-text)"
          ><textPath href="#${arcId}" startOffset="50%" text-anchor="middle">В ЯБЛОЧКО!</textPath></text>
        </svg>
      `;

      layer.appendChild(wrap);
      setTimeout(() => wrap.remove(), TOTAL_LIFETIME_MS);
    }

    window.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.closest(interactiveSelector)) return;
      if (Math.random() > HIT_CHANCE) return;
      spawnBullseye(e.clientX, e.clientY);
    });
  }
</script>
