---
import { contacts } from '../data/site';
---

<div id="direct-popup-overlay" class="direct-popup-overlay" hidden>
  <div class="direct-popup panel" role="dialog" aria-modal="true" aria-labelledby="direct-popup-title">
    <button type="button" class="direct-popup-close" aria-label="Закрыть">×</button>

    <p class="mono-label">Реклама · Яндекс.Директ</p>
    <h2 id="direct-popup-title" class="direct-popup-title">Вы попали точно куда нужно</h2>
    <p class="direct-popup-text">
      «Яндекс.Директ» привёл вас на мой сайт, значит вы там, где и должны быть! Тоже хотите
      настроить себе эффективную рекламу? Заполняйте форму:
    </p>

    <form id="direct-popup-form" novalidate>
      <div class="direct-popup-row">
        <label class="direct-popup-label" for="dp-name">Имя *</label>
        <input class="direct-popup-input" type="text" id="dp-name" name="name" required autocomplete="name" />
      </div>

      <div class="direct-popup-row">
        <label class="direct-popup-label" for="dp-phone">Телефон *</label>
        <input
          class="direct-popup-input"
          type="tel"
          id="dp-phone"
          name="phone"
          required
          placeholder="+7 (___) ___-__-__"
          inputmode="numeric"
          autocomplete="tel"
        />
      </div>

      <!-- honeypot: скрытое поле-ловушка для ботов -->
      <div class="direct-popup-honeypot" aria-hidden="true">
        <label for="dp-hp">Оставьте пустым</label>
        <input type="text" id="dp-hp" name="hp" tabindex="-1" autocomplete="off" />
      </div>

      <label class="direct-popup-consent">
        <input type="checkbox" id="dp-consent" name="consent" required />
        <span>
          Согласен на обработку персональных данных
          согласно <a href="#" class="privacy-modal-trigger">политике конфиденциальности</a>
        </span>
      </label>

      <button type="submit" class="btn btn-primary direct-popup-submit" id="dp-submit" disabled>
        Отправить заявку
      </button>
    </form>
    <p class="direct-popup-status" id="dp-status" role="status" aria-live="polite"></p>
  </div>
</div>

<style>
  .direct-popup-overlay {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 100;
    background: rgba(6, 6, 8, 0.7);
    backdrop-filter: blur(4px);
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  /* Скрытие через [hidden] не должно перебиваться этим display —
     иначе окно остаётся кликабельным поверх страницы, даже когда «скрыто». */
  .direct-popup-overlay:not([hidden]) {
    display: flex;
  }

  .direct-popup {
    width: 100%;
    max-width: 480px;
    max-height: 88vh;
    overflow-y: auto;
    padding: var(--card-padding);
    text-align: left;
  }

  .direct-popup-close {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-text);
    font-size: 18px;
    line-height: 1;
    cursor: pointer;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .direct-popup-close:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .direct-popup-title {
    font-size: 26px;
    margin-top: 12px;
    padding-right: 40px;
  }

  .direct-popup-text {
    margin-top: 14px;
    color: var(--color-text-muted);
    font-size: 15px;
    line-height: 1.6;
  }

  #direct-popup-form {
    margin-top: 28px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .direct-popup-row {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .direct-popup-label {
    font-size: 14px;
    color: var(--color-text-muted);
  }

  .direct-popup-input {
    width: 100%;
    padding: 12px 16px;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-input);
    color: var(--color-text);
  }

  .direct-popup-input:focus-visible {
    border-color: var(--color-accent);
  }

  .direct-popup-honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
  }

  .direct-popup-consent {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 13px;
    line-height: 1.5;
    color: var(--color-text-muted);
    cursor: pointer;
  }

  .direct-popup-consent input {
    margin-top: 3px;
    accent-color: var(--color-accent);
  }

  .direct-popup-consent a {
    color: var(--color-text);
    text-decoration: underline;
  }

  .direct-popup-consent a:hover {
    color: var(--color-accent);
  }

  .direct-popup-submit {
    margin-top: 2px;
  }

  .direct-popup-submit:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .direct-popup-submit:disabled:hover {
    box-shadow: none;
  }

  .direct-popup-status {
    margin-top: 14px;
    font-size: 15px;
    min-height: 20px;
    display: flex;
    align-items: baseline;
    gap: 10px;
  }

  .direct-popup-status:empty {
    margin-top: 0;
  }

  .direct-popup-status::before {
    content: '';
    flex-shrink: 0;
    width: 9px;
    height: 9px;
    transform: translateY(-1px);
  }

  .direct-popup-status:empty::before {
    display: none;
  }

  .direct-popup-status[data-state='success'] {
    color: var(--color-text);
  }

  .direct-popup-status[data-state='success']::before {
    background: var(--color-accent);
  }

  .direct-popup-status[data-state='error'] {
    color: var(--color-error);
  }

  .direct-popup-status[data-state='error']::before {
    background: var(--color-error);
  }
</style>

<script define:vars={{ telegramHref: contacts.telegramHref }}>
  const STORAGE_AD_FLAG = 'yaropolov_ad_visit';
  const STORAGE_SHOWN_FLAG = 'yaropolov_ad_popup_shown';
  const SHOW_DELAY_MS = 10000;
  const YM_COUNTER_ID = 112339088;

  function reachGoal(name) {
    try {
      if (typeof window.ym === 'function') window.ym(YM_COUNTER_ID, 'reachGoal', name);
    } catch {
      /* аналитика не должна ронять форму */
    }
  }

  // 1. Разметка перехода с рекламы: yclid добавляется Яндекс.Директом
  // автоматически при клике по объявлению.
  try {
    const params = new URLSearchParams(location.search);
    if (params.has('yclid')) {
      sessionStorage.setItem(STORAGE_AD_FLAG, '1');
    }
  } catch {
    /* sessionStorage может быть недоступен (приватный режим и т.п.) */
  }

  const overlay = document.getElementById('direct-popup-overlay');
  const closeBtn = overlay?.querySelector('.direct-popup-close');
  const form = document.getElementById('direct-popup-form');
  const consent = document.getElementById('dp-consent');
  const submitBtn = document.getElementById('dp-submit');
  const statusEl = document.getElementById('dp-status');

  let mainFormSubmitted = false;

  function hasFlag(key) {
    try {
      return sessionStorage.getItem(key) === '1';
    } catch {
      return false;
    }
  }

  function setFlag(key) {
    try {
      sessionStorage.setItem(key, '1');
    } catch {
      /* ignore */
    }
  }

  function showPopup() {
    if (!overlay || mainFormSubmitted) return;
    if (hasFlag(STORAGE_SHOWN_FLAG)) return;
    setFlag(STORAGE_SHOWN_FLAG);
    overlay.hidden = false;
    reachGoal('ad_popup_shown');
  }

  function hidePopup() {
    if (overlay) overlay.hidden = true;
  }

  window.addEventListener('lead-form-submitted', () => {
    mainFormSubmitted = true;
    hidePopup();
  });

  if (hasFlag(STORAGE_AD_FLAG) && !hasFlag(STORAGE_SHOWN_FLAG)) {
    setTimeout(showPopup, SHOW_DELAY_MS);
  }

  closeBtn?.addEventListener('click', hidePopup);
  overlay?.addEventListener('click', (e) => {
    if (e.target === overlay) hidePopup();
  });
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && overlay && !overlay.hidden) hidePopup();
  });

  consent?.addEventListener('change', () => {
    if (submitBtn) submitBtn.disabled = !consent.checked;
  });

  // Маска номера телефона: +7 (XXX) XXX-XX-XX
  function formatPhone(raw) {
    let digits = raw.replace(/\D/g, '');
    if (digits.startsWith('7') || digits.startsWith('8')) digits = digits.slice(1);
    digits = digits.slice(0, 10);

    let out = '+7';
    if (digits.length > 0) out += ' (' + digits.slice(0, 3);
    if (digits.length >= 3) out += ')';
    if (digits.length > 3) out += ' ' + digits.slice(3, 6);
    if (digits.length > 6) out += '-' + digits.slice(6, 8);
    if (digits.length > 8) out += '-' + digits.slice(8, 10);
    return out;
  }

  const phoneInput = document.getElementById('dp-phone');
  phoneInput?.addEventListener('input', () => {
    phoneInput.value = formatPhone(phoneInput.value);
  });
  phoneInput?.addEventListener('focus', () => {
    if (!phoneInput.value) phoneInput.value = '+7 (';
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    const formData = new FormData(form);
    const phone = String(formData.get('phone') || '');

    const payload = {
      name: String(formData.get('name') || ''),
      method: 'phone',
      contact: phone,
      consent: consent?.checked ? 'true' : 'false',
      hp: String(formData.get('hp') || ''),
      source: 'ad_popup',
    };

    if (submitBtn) submitBtn.disabled = true;
    if (statusEl) {
      statusEl.textContent = 'Отправляю...';
      statusEl.removeAttribute('data-state');
    }

    try {
      const res = await fetch('/api/send-lead', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      if (!res.ok) throw new Error('request failed');

      form.hidden = true;
      if (statusEl) {
        statusEl.textContent = 'Заявка отправлена. Отвечу в ближайшее время.';
        statusEl.dataset.state = 'success';
      }
      mainFormSubmitted = true;
      reachGoal('ad_popup_lead');
      // Событие диспатчим вместе со скрытием, а не сразу — иначе собственный же
      // слушатель 'lead-form-submitted' ниже мгновенно закроет попап, не дав
      // посетителю увидеть сообщение об успехе.
      setTimeout(() => {
        hidePopup();
        window.dispatchEvent(new CustomEvent('lead-form-submitted'));
      }, 2500);
    } catch (err) {
      if (statusEl) {
        statusEl.textContent = `Не получилось отправить. Попробуйте написать в Telegram напрямую: ${telegramHref}`;
        statusEl.dataset.state = 'error';
      }
      if (submitBtn) submitBtn.disabled = !consent?.checked;
    }
  });
</script>
