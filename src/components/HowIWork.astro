---
import { howIWork, honestNote } from '../data/site';
---

<section class="how-it-works">
  <div class="section section-gap">
    <p class="mono-label mono-label-dark">Как я работаю</p>
    <h2 class="how-title">От прогноза до отчёта — без сюрпризов</h2>

    <div class="how-grid">
      {howIWork.map((item) => (
        <div class="how-item">
          <div class="how-hairline" aria-hidden="true"></div>
          <p class="how-number mono-label mono-label-dark">{item.number}</p>
          <h3 class="how-item-title">{item.title}</h3>
          <p class="how-item-text">{item.text}</p>
        </div>
      ))}
    </div>

    <div class="honest-note">
      <p>{honestNote}</p>
    </div>
  </div>
</section>

<style>
  .how-it-works {
    background: var(--color-invert-bg);
    color: var(--color-invert-text);
  }

  .mono-label-dark {
    color: var(--color-accent-dim);
  }

  .how-title {
    font-size: 32px;
    margin-top: 12px;
    max-width: 640px;
    color: var(--color-invert-text);
  }

  @media (min-width: 640px) {
    .how-title {
      font-size: 44px;
    }
  }

  .how-grid {
    margin-top: 56px;
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
  }

  @media (min-width: 720px) {
    .how-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 48px;
    }
  }

  @media (min-width: 1100px) {
    .how-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .how-hairline {
    height: 1px;
    background: #d8d8d8;
    margin-bottom: 20px;
  }

  .how-number {
    margin-bottom: 12px;
  }

  .how-item-title {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.01em;
  }

  .how-item-text {
    margin-top: 12px;
    font-size: 15px;
    line-height: 1.55;
    color: #454545;
  }

  .honest-note {
    margin-top: 64px;
    padding: 24px 28px;
    background: var(--color-accent);
    border-left: 3px solid var(--color-accent-dim);
    max-width: 760px;
  }

  .honest-note p {
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-invert-text);
  }
</style>
