---
import { howIWork, honestNote } from '../data/site';
---

<section class="how-it-works light-surface" id="how">
  <div class="section section-gap">
    <p class="mono-label mono-label-dark">Как я работаю</p>
    <h2 class="how-title">От прогноза до отчёта —<br />без сюрпризов</h2>

    <div class="how-grid">
      {howIWork.map((item) => (
        <div class="how-item">
          <div class="how-hairline" aria-hidden="true"></div>
          <p class="how-number">{item.number}</p>
          <h3 class="how-item-title">{item.title}</h3>
          <p class="how-item-text">{item.text}</p>
        </div>
      ))}
    </div>

    <div class="honest-note grid-shield">
      <p class="honest-note-label mono-label mono-label-dark">Важно</p>
      <p class="honest-note-text">{honestNote}</p>
    </div>
  </div>
</section>

<style>
  .how-it-works {
    background: var(--color-invert-bg);
    color: var(--color-invert-text);
  }

  .mono-label-dark {
    color: var(--color-invert-accent);
  }

  .mono-label-dark::before {
    background: var(--color-invert-accent);
  }

  .how-title {
    font-size: 32px;
    margin-top: 12px;
    max-width: 680px;
    color: var(--color-invert-text);
  }

  @media (min-width: 640px) {
    .how-title {
      font-size: 46px;
    }
  }

  .how-grid {
    margin-top: 56px;
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
  }

  @media (min-width: 720px) {
    .how-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 48px;
    }
  }

  @media (min-width: 1100px) {
    .how-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .how-hairline {
    height: 1px;
    background: var(--color-invert-text);
    opacity: 0.12;
    margin-bottom: 18px;
  }

  .how-number {
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 13px;
    letter-spacing: 0.08em;
    color: var(--color-invert-accent);
    line-height: 1;
    margin-bottom: 12px;
  }

  .how-item-title {
    font-family: var(--font-display);
    font-size: 21px;
    font-weight: 400;
    letter-spacing: -0.01em;
  }

  .how-item-text {
    margin-top: 12px;
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--color-invert-text-muted);
    white-space: pre-line;
  }

  /* Та же баухаус-панель, что и в тёмных секциях (плоский цвет, острый
     угол, жёсткая тень-блок и угловая марка), но в светлых тонах для
     инвертированной секции. */
  .honest-note {
    margin-top: 72px;
    padding: 32px;
    background: var(--color-invert-surface);
    border: 2px solid var(--color-invert-text);
    border-radius: 0;
    position: relative;
    overflow: hidden;
    box-shadow: 10px 10px 0 0 var(--color-accent);
    max-width: 780px;
  }

  .honest-note::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 22px;
    height: 22px;
    background: var(--color-accent);
  }

  .honest-note-label {
    margin-bottom: 12px;
    display: inline-flex;
  }

  .honest-note-text {
    font-size: 16.5px;
    line-height: 1.65;
    color: var(--color-invert-text);
    opacity: 0.85;
  }
</style>
