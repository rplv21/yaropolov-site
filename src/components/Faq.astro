---
import { faq } from '../data/site';
---

<section class="section section-gap" id="faq">
  <p class="mono-label">Вопросы</p>
  <h2 class="faq-title">Отвечаю честно</h2>

  <div class="faq-list">
    {faq.map((item) => (
      <details class="faq-item" name="faq-accordion">
        <summary class="faq-summary">
          <span class="faq-number">{item.number}</span>
          <span class="faq-question">{item.question}</span>
        </summary>
        <p class="faq-answer">{item.answer}</p>
        {item.articleSlug && (
          <p class="faq-more">
            Подробнее в статье: <a href={`/articles/${item.articleSlug}`}>{item.articleLabel}</a>
          </p>
        )}
      </details>
    ))}
  </div>
</section>

<style>
  .faq-title {
    font-size: 32px;
    margin-top: 12px;
    max-width: 640px;
  }

  @media (min-width: 640px) {
    .faq-title {
      font-size: 44px;
    }
  }

  .faq-list {
    margin-top: 48px;
    max-width: 820px;
    border-top: 1px solid var(--color-border);
  }

  .faq-item {
    border-bottom: 1px solid var(--color-border);
    border-left: 4px solid transparent;
    padding: 22px 20px 22px 18px;
    transition: border-left-color 0.2s ease, background 0.2s ease;
  }

  .faq-item[open] {
    border-left-color: var(--color-accent);
    background: rgba(255, 255, 255, 0.045);
  }

  .faq-summary {
    display: flex;
    align-items: baseline;
    gap: 18px;
    cursor: pointer;
    list-style: none;
  }

  .faq-summary::-webkit-details-marker {
    display: none;
  }

  .faq-summary::after {
    content: '+';
    margin-left: auto;
    font-family: var(--font-condensed);
    font-weight: 700;
    color: var(--color-text-dim);
    font-size: 22px;
    flex-shrink: 0;
  }

  .faq-item[open] .faq-summary::after {
    content: '−';
    color: var(--color-accent);
  }

  .faq-number {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-text-dim);
  }

  .faq-question {
    font-family: var(--font-display);
    font-weight: 400;
    text-transform: none;
    font-size: 18px;
    color: var(--color-text);
  }

  .faq-answer {
    margin-top: 16px;
    padding-left: 42px;
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--color-text-muted);
    max-width: 680px;
    white-space: pre-line;
  }

  .faq-more {
    margin-top: 10px;
    padding-left: 42px;
    font-size: 14px;
    color: var(--color-text-dim);
  }

  .faq-more a {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .faq-more a:hover {
    color: var(--color-accent);
  }
</style>
