<style>
  #load-screen {
    position: fixed;
    inset: 0;
    z-index: 200;
    background: var(--color-canvas);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.5s ease;
  }

  #load-screen.is-hiding {
    opacity: 0;
    pointer-events: none;
  }

  .load-mark {
    width: min(70vw, 420px);
    height: auto;
    opacity: 0;
    transform: scale(0.92);
    animation: load-mark-in 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
  }

  @keyframes load-mark-in {
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  /* Диагональная кремовая полоса читается как поднятая рука человечка —
     машем ей дважды после того, как знак появился, и как раз успеваем
     закончить до начала затухания экрана (см. HOLD_MS в скрипте). */
  .load-arm {
    transform-box: fill-box;
    transform-origin: 88% 88%;
    animation: load-arm-wave 0.45s ease-in-out 0.6s 2;
  }

  @keyframes load-arm-wave {
    0%,
    100% {
      transform: rotate(0deg);
    }
    30% {
      transform: rotate(20deg);
    }
    65% {
      transform: rotate(-10deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .load-mark {
      animation: none;
      opacity: 1;
      transform: none;
    }
    .load-arm {
      animation: none;
    }
    #load-screen {
      transition: none;
    }
  }
</style>

<noscript>
  <style>
    /* Без JS некому убрать заставку — не блокируем сайт для таких визитов. */
    #load-screen {
      display: none;
    }
  </style>
</noscript>

<script>
  const screen = document.getElementById('load-screen');

  if (screen) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const FADE_MS = 500;
    const HOLD_MS = reduceMotion ? 300 : 1500; // при уменьшенном движении показываем короче, без анимации

    setTimeout(() => {
      screen.classList.add('is-hiding');
      setTimeout(() => screen.remove(), FADE_MS);
    }, HOLD_MS);
  }
</script>
