---
import { nav, contacts } from '../data/site';
import BrandLogo from './BrandLogo.astro';
---

<header class="header" id="site-header">
  <div class="header-inner section">
    <a href="#main" class="brand" aria-label="Yaropolov.ru">
      <BrandLogo class="brand-logo" />
    </a>

    <nav class="nav" aria-label="Основная навигация">
      <ul>
        {nav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <a href={contacts.telegramHref} class="btn btn-primary header-cta" target="_blank" rel="noopener noreferrer">
      Написать
    </a>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(16, 14, 11, 0.42);
    backdrop-filter: blur(8px) saturate(1.1);
    -webkit-backdrop-filter: blur(8px) saturate(1.1);
    border-bottom: 1px solid var(--color-border);
    transition: transform 0.35s ease;
  }

  .header.header-hidden {
    transform: translateY(-100%);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 76px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--color-text);
  }

  .brand :global(.brand-logo) {
    height: 42px;
    width: auto;
    flex-shrink: 0;
  }

  .nav {
    display: none;
  }

  .nav ul {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .nav a {
    font-size: 14.5px;
    color: var(--color-text-muted);
    transition: color 0.2s ease;
  }

  .nav a:hover {
    color: var(--color-text);
  }

  .header-cta {
    padding: 10px 22px;
    font-size: 14px;
    white-space: nowrap;
  }

  @media (min-width: 1024px) {
    .nav {
      display: block;
    }
  }
</style>

<script>
  let lastScrollY = window.scrollY;
  const header = document.getElementById('site-header');

  function onScroll() {
    if (!header) return;
    const currentScrollY = window.scrollY;
    const scrollingDown = currentScrollY > lastScrollY;

    if (scrollingDown && currentScrollY > 120) {
      header.classList.add('header-hidden');
    } else {
      header.classList.remove('header-hidden');
    }

    lastScrollY = currentScrollY;
  }

  window.addEventListener('scroll', onScroll, { passive: true });
</script>
