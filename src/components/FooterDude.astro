<div id="footer-dude-wrap" class="footer-dude-wrap" hidden aria-hidden="true">
  <div class="footer-dude-bubble" id="footer-dude-bubble"></div>
  <svg class="footer-dude" id="footer-dude-ball" viewBox="0 0 60 60" width="26" height="26">
    <circle
      cx="30"
      cy="30"
      r="21"
      fill="none"
      stroke="var(--color-accent)"
      stroke-width="16"
      stroke-dasharray="112 20"
      transform="rotate(200 30 30)"
    />
  </svg>
</div>

<style>
  .footer-dude-wrap {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 45;
    pointer-events: none;
    will-change: transform;
  }

  .footer-dude-wrap.is-interactive {
    pointer-events: auto;
    cursor: pointer;
  }

  .footer-dude {
    display: block;
    overflow: visible;
  }

  .footer-dude-bubble {
    position: absolute;
    bottom: 100%;
    left: 50%;
    transform: translateX(-50%);
    margin-bottom: 14px;
    padding: 8px 14px;
    background: var(--color-invert-bg);
    color: var(--color-invert-text);
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    white-space: nowrap;
    border: 2px solid var(--color-canvas);
    box-shadow: 4px 4px 0 0 var(--color-accent);
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  .footer-dude-bubble::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    border: 7px solid transparent;
    border-top-color: var(--color-invert-bg);
  }

  .footer-dude-bubble.is-visible {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-dude-wrap {
      display: none;
    }
  }
</style>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const isMobile = window.innerWidth < 768;

  if (!reduceMotion && !isMobile) {
    const footer = document.getElementById('contact');
    const wrap = document.getElementById('footer-dude-wrap');
    const ball = document.getElementById('footer-dude-ball');
    const bubble = document.getElementById('footer-dude-bubble');

    if (footer && wrap && ball && bubble) {
      const BALL_W = 26;
      const BALL_H = 26;
      const BALL_R = 13;
      const MARGIN = 30;
      const WALK_SPEED = 55; // px/s
      const RUN_SPEED = 340; // px/s
      const ENTER_SPEED = 85; // px/s — выкатывание из-за края экрана

      let footerTop = 0;
      let x = -BALL_W;
      let dir = 1; // 1 = вправо, -1 = влево
      let rollAngle = 0; // deg, накапливается пропорционально пройденному пути
      let rafId = 0;
      let lastT = 0;
      let mode: 'idle' | 'entering' | 'walking' | 'running' = 'idle';
      let canEnter = true;
      let hovering = false;

      function updateFooterTop() {
        footerTop = footer!.getBoundingClientRect().top;
      }

      function applyTransform() {
        // Обновляем на каждом кадре, а не только по 'scroll' — во время
        // плавного (scroll-behavior: smooth) скролла событий scroll может
        // приходить меньше, чем кадров анимации, и шарик кадр-другой едет
        // по устаревшей позиции футера, "проваливаясь" за реальную границу.
        updateFooterTop();
        // Кольцо занимает почти всю высоту viewBox, поэтому нижний край
        // шарика при таком y приходится ровно на верхнюю границу футера,
        // без нахлёста и без зазора.
        const y = footerTop - BALL_H;
        // Кольцо не нужно "разворачивать" зеркально по направлению (как
        // фигуру с лицевой стороной) — scaleX(dir) на обёртке отразил бы
        // и собственное вращение шарика, из-за чего при движении влево оно
        // визуально выглядело бы всё тем же вращением по часовой стрелке.
        wrap!.style.transform = `translate(${x}px, ${y}px)`;
        ball!.style.transform = `rotate(${rollAngle}deg)`;
      }

      function showBubble(text: string) {
        bubble!.textContent = text;
        bubble!.classList.add('is-visible');
      }

      function hideBubble() {
        bubble!.classList.remove('is-visible');
      }

      function stopLoop() {
        if (rafId) cancelAnimationFrame(rafId);
        rafId = 0;
      }

      function enterLoop(t: number) {
        if (!lastT) lastT = t;
        const dt = (t - lastT) / 1000;
        lastT = t;

        const delta = ENTER_SPEED * dt;
        x += delta;
        rollAngle += (delta / BALL_R) * (180 / Math.PI);

        if (x >= MARGIN) {
          x = MARGIN;
          applyTransform();
          startWalking();
          return;
        }

        applyTransform();
        rafId = requestAnimationFrame(enterLoop);
      }

      function walkLoop(t: number) {
        if (!lastT) lastT = t;
        const dt = (t - lastT) / 1000;
        lastT = t;

        const speed = mode === 'running' ? RUN_SPEED : WALK_SPEED;
        const delta = dir * speed * dt;
        x += delta;
        // Качение: угол пропорционален пройденному пути (радианы = путь / радиус).
        rollAngle += (delta / BALL_R) * (180 / Math.PI);

        if (mode === 'walking') {
          const leftBound = MARGIN;
          const rightBound = window.innerWidth - MARGIN - BALL_W;
          if (x >= rightBound) {
            x = rightBound;
            dir = -1;
          } else if (x <= leftBound) {
            x = leftBound;
            dir = 1;
          }
        }

        if (mode === 'running' && x > window.innerWidth + BALL_W) {
          finishRunAway();
          return;
        }

        applyTransform();
        rafId = requestAnimationFrame(walkLoop);
      }

      function startWalking() {
        mode = 'walking';
        lastT = 0;
        stopLoop();
        rafId = requestAnimationFrame(walkLoop);
      }

      function finishRunAway() {
        stopLoop();
        wrap!.hidden = true;
        wrap!.classList.remove('is-interactive');
        hideBubble();
        mode = 'idle';
      }

      function beginSequence() {
        if (mode !== 'idle') return;
        mode = 'entering';
        updateFooterTop();
        dir = 1;
        x = -BALL_W - 90; // полностью за левой границей страницы/экрана
        wrap!.hidden = false;
        wrap!.classList.add('is-interactive');
        applyTransform();

        lastT = 0;
        stopLoop();
        rafId = requestAnimationFrame(enterLoop);
      }

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              if (canEnter) {
                canEnter = false;
                beginSequence();
              }
            } else {
              // Секция ушла из вида — прячем и разрешаем повторный выход
              // при следующем появлении футера.
              stopLoop();
              wrap!.hidden = true;
              wrap!.classList.remove('is-interactive');
              hideBubble();
              mode = 'idle';
              canEnter = true;
            }
          });
        },
        { threshold: 0.15 }
      );
      observer.observe(footer);

      window.addEventListener(
        'scroll',
        () => {
          if (mode === 'idle') return;
          updateFooterTop();
        },
        { passive: true }
      );
      window.addEventListener('resize', () => {
        if (mode !== 'idle') updateFooterTop();
      });

      wrap.addEventListener('mouseenter', () => {
        if (mode !== 'walking') return;
        hovering = true;
        stopLoop();
        showBubble('Ждём вашу заявку!');
      });

      wrap.addEventListener('mouseleave', () => {
        if (!hovering) return;
        hovering = false;
        hideBubble();
        if (mode === 'walking') {
          lastT = 0;
          rafId = requestAnimationFrame(walkLoop);
        }
      });

      wrap.addEventListener('click', () => {
        if (mode !== 'walking') return;
        hovering = false;
        stopLoop();
        dir = 1;
        showBubble('Ай!');

        setTimeout(() => {
          hideBubble();
          mode = 'running';
          lastT = 0;
          rafId = requestAnimationFrame(walkLoop);
        }, 450);
      });
    }
  }
</script>
