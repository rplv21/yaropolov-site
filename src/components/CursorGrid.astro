<div class="cursor-grid" aria-hidden="true"></div>

<style>
  .cursor-grid {
    display: none;
  }

  @media (hover: hover) and (pointer: fine) {
    /* Слой сетки лежит НИЖЕ .page-content (z-index:1 в global.css) — оба
       элемента прямые дети <body>, поэтому z-index сравнивается напрямую.
       Секции сайта (.section, .page-content) сами по себе прозрачны и не
       красят фон — сквозь них виден фон body (--color-canvas), и именно
       там сетка и появляется. А любая непрозрачная поверхность поверх неё
       (баухаус-панели, фотографии, чёрная полоса «Как я работаю», шапка
       и футер) естественным образом перекрывает сетку сама по себе —
       никакой JS-логики для "гашения" рядом с фото/карточками не нужно. */
    .cursor-grid {
      display: block;
      position: fixed;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      opacity: 0;
      background-size: 32px 32px;
      background-image:
        linear-gradient(var(--color-grid-line) 1px, transparent 1px),
        linear-gradient(90deg, var(--color-grid-line) 1px, transparent 1px);
      -webkit-mask-image: radial-gradient(circle 240px at var(--cursor-x, 50%) var(--cursor-y, 50%), black 0%, transparent 100%);
      mask-image: radial-gradient(circle 240px at var(--cursor-x, 50%) var(--cursor-y, 50%), black 0%, transparent 100%);
      transition: opacity 0.4s ease;
    }

    .cursor-grid.is-active {
      opacity: 0.22;
    }
  }
</style>

<script>
  const grid = document.querySelector<HTMLElement>('.cursor-grid');

  if (grid && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
    let hideTimeout: ReturnType<typeof setTimeout>;

    window.addEventListener(
      'mousemove',
      (e) => {
        grid.style.setProperty('--cursor-x', `${e.clientX}px`);
        grid.style.setProperty('--cursor-y', `${e.clientY}px`);
        grid.classList.add('is-active');

        clearTimeout(hideTimeout);
        hideTimeout = setTimeout(() => grid.classList.remove('is-active'), 2000);
      },
      { passive: true }
    );

    document.addEventListener('mouseleave', () => grid.classList.remove('is-active'));
  }
</script>
