---
import { case1, case2 } from '../data/site';
import AnimatedCounter from './AnimatedCounter.astro';
import GrowthChart from './GrowthChart.astro';
---

<section class="cases section section-gap" id="cases">
  <p class="mono-label">Кейсы</p>
  <h2 class="cases-title">Два проекта, разобранных подробно</h2>

  <div class="case-block">
    <div class="case-copy">
      <p class="mono-label">{case1.label}</p>
      <h3 class="case-name">{case1.title}</h3>
      <p class="case-context">{case1.context}</p>
      <ul class="case-actions">
        {case1.actions.map((a) => <li>{a}</li>)}
      </ul>
      <p class="case-period mono-label">{case1.period}</p>
    </div>

    <div class="case-panel glass">
      <AnimatedCounter num={case1.growth.value} prefix="+" suffix="%" label={case1.growth.label} size="lg" />
      <div class="case-chart">
        <GrowthChart startLabel="Старт" endLabel={`+${case1.growth.value}%`} caption={case1.growth.description} startY={95} />
      </div>
      <div class="case-stat-grid" style={`--stat-count: ${case1.statsRow1.length}`}>
        {case1.statsRow1.map((s) => (
          <AnimatedCounter num={s.num} suffix={s.suffix} label={s.label} size="sm" />
        ))}
      </div>
      <div class="case-stat-grid case-stat-grid-secondary" style={`--stat-count: ${case1.statsRow1.length}`}>
        {case1.statsRow2.map((s) => (
          <AnimatedCounter num={s.num} suffix={s.suffix} label={s.label} size="sm" />
        ))}
      </div>
    </div>
  </div>

  <div class="case-divider" aria-hidden="true"></div>

  <div class="case-block">
    <div class="case-copy">
      <p class="mono-label">{case2.label}</p>
      <h3 class="case-name">
        Ярославский областной<br />
        Дом Актера<br />
        им. Сергея Пускепалиса
      </h3>
      <p class="case-context">{case2.context}</p>
      <ul class="case-actions">
        {case2.actions.map((a) => <li>{a}</li>)}
      </ul>
      <p class="case-period mono-label">{case2.period}</p>
    </div>

    <div class="case-panel glass">
      <div class="case-headline-grid">
        {case2.headline.map((s) => (
          <AnimatedCounter num={s.num} suffix={s.suffix} prefix={s.prefix} decimals={s.decimals} label={s.label} size="lg" />
        ))}
      </div>
      <div class="case-chart">
        <GrowthChart startLabel="0" endLabel={`${case2.chart.value} билетов по рекламе`} caption={case2.chart.description} />
      </div>
      <div class="case-stat-grid" style={`--stat-count: ${case2.statsRow1.length}`}>
        {case2.statsRow1.map((s) => (
          <AnimatedCounter num={s.num} suffix={s.suffix} prefix={s.prefix} decimals={s.decimals} label={s.label} size="sm" />
        ))}
      </div>
      <div class="case-stat-grid case-stat-grid-secondary" style={`--stat-count: ${case2.statsRow1.length}`}>
        {case2.statsRow2.map((s) => (
          <AnimatedCounter num={s.num} suffix={s.suffix} prefix={s.prefix} decimals={s.decimals} label={s.label} size="sm" />
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .cases-title {
    font-size: 32px;
    margin-top: 12px;
    max-width: 640px;
  }

  @media (min-width: 640px) {
    .cases-title {
      font-size: 44px;
    }
  }

  .case-block {
    margin-top: 56px;
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
  }

  @media (min-width: 960px) {
    .case-block {
      grid-template-columns: 0.85fr 1.15fr;
      gap: 56px;
      align-items: start;
    }
  }

  /* min-width:0 — иначе fr-колонки в двух независимых grid-блоках
     подстраиваются под свой контент и края панелей/графиков расходятся */
  .case-copy,
  .case-panel {
    min-width: 0;
  }

  .case-name {
    font-size: 28px;
    margin-top: 12px;
  }

  .case-context {
    margin-top: 16px;
    color: var(--color-text-muted);
    font-size: 16px;
  }

  .case-actions {
    margin-top: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .case-actions li {
    position: relative;
    padding-left: 20px;
    font-size: 15px;
    color: var(--color-text);
  }

  .case-actions li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 8px;
    width: 6px;
    height: 6px;
    background: var(--color-accent);
    border-radius: 50%;
  }

  .case-period {
    margin-top: 24px;
  }

  .case-panel {
    padding: var(--card-padding);
  }

  .case-headline-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  .case-chart {
    margin-top: 32px;
  }

  .case-stat-grid {
    margin-top: 32px;
    padding-top: 32px;
    border-top: 1px solid var(--color-border);
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px 12px;
  }

  @media (min-width: 560px) {
    .case-stat-grid {
      grid-template-columns: repeat(var(--stat-count, 3), 1fr);
    }
  }

  .case-stat-grid-secondary {
    margin-top: 16px;
    padding-top: 0;
    border-top: none;
  }

  .case-divider {
    width: 120px;
    height: 3px;
    background: var(--color-accent);
    margin: 56px auto 0;
  }
</style>
