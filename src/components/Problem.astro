---
import { problems } from '../data/site';
---

<section class="section section-gap" id="problem">
  <p class="mono-label">Частые проблемы</p>
  <h2 class="problem-title">Узнаёте себя?</h2>

  <div class="problem-list">
    {problems.map((p, i) => (
      <div class="problem-row">
        <span class="problem-num">{String(i + 1).padStart(2, '0')}</span>
        <div class="problem-body">
          <p class="problem-quote">{p.quote}</p>
          <p class="problem-comment">{p.comment}</p>
        </div>
      </div>
    ))}
  </div>

  <a href="https://yaropolov.ru/articles/" class="btn btn-ghost problem-articles-link">
    Подробные разборы читайте в разделе Статьи
  </a>
</section>

<style>
  .problem-title {
    font-size: 32px;
    max-width: 640px;
    margin-top: 14px;
  }

  @media (min-width: 640px) {
    .problem-title {
      font-size: 44px;
    }
  }

  .problem-list {
    margin-top: 56px;
    border-top: 1px solid var(--color-border);
  }

  .problem-row {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 24px;
    padding-block: 32px;
    border-bottom: 1px solid var(--color-border);
    transition: padding-left 0.25s ease;
  }

  .problem-row:hover {
    padding-left: 12px;
  }

  .problem-row:hover .problem-quote {
    color: var(--color-accent);
  }

  @media (min-width: 720px) {
    .problem-row {
      grid-template-columns: 100px 1fr;
      gap: 40px;
    }
  }

  .problem-num {
    font-family: var(--font-display);
    font-weight: 200;
    font-size: 32px;
    color: var(--color-text-dim);
  }

  .problem-quote {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 22px;
    letter-spacing: -0.01em;
    color: var(--color-text);
    line-height: 1.3;
    transition: color 0.3s ease;
  }

  @media (min-width: 720px) {
    .problem-quote {
      font-size: 26px;
    }
  }

  .problem-comment {
    margin-top: 12px;
    font-size: 15.5px;
    color: var(--color-text-muted);
    max-width: 560px;
    white-space: pre-line;
  }

  .problem-articles-link {
    margin-top: 40px;
  }
</style>
