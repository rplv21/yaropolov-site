---
interface Props {
  startLabel: string;
  endLabel: string;
  caption: string;
  /** Y-координата начала линии (0 сверху..180 снизу). 150 — от нуля (базовая линия). Меньше — старт с уже ненулевого уровня. */
  startY?: number;
}

const { startLabel, endLabel, caption, startY = 150 } = Astro.props;
const uid = `chart-${Math.random().toString(36).slice(2, 9)}`;
const ctrl2Y = Math.min(60, startY - 10);
---

<div class="growth-chart" data-growth-chart>
  <svg viewBox="0 0 400 180" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <defs>
      <linearGradient id={`${uid}-fill`} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="rgba(227,178,0,0.15)" />
        <stop offset="100%" stop-color="rgba(227,178,0,0)" />
      </linearGradient>
    </defs>

    <!-- сетка -->
    <line x1="20" y1="150" x2="380" y2="150" stroke="var(--color-border)" stroke-width="1" />
    <line x1="20" y1="95" x2="380" y2="95" stroke="var(--color-border)" stroke-width="1" stroke-dasharray="2 4" />
    <line x1="20" y1="40" x2="380" y2="40" stroke="var(--color-border)" stroke-width="1" stroke-dasharray="2 4" />

    <path
      d={`M20,150 L20,${startY} C 140,${startY} 180,${ctrl2Y} 380,25 L380,150 Z`}
      fill={`url(#${uid}-fill)`}
      class="growth-area"
    />
    <path
      d={`M20,${startY} C 140,${startY} 180,${ctrl2Y} 380,25`}
      fill="none"
      stroke="var(--color-accent)"
      stroke-width="2.5"
      stroke-linecap="round"
      pathLength="100"
      class="growth-line"
    />

    <circle cx="20" cy={startY} r="4" fill="var(--color-accent)" class="growth-point growth-point-start" />
    <circle cx="380" cy="25" r="4" fill="var(--color-accent)" class="growth-point growth-point-end" />
  </svg>

  <div class="growth-labels">
    <span class="mono-label growth-label-start">{startLabel}</span>
    <span class="mono-label growth-label-end">{endLabel}</span>
  </div>
  <p class="growth-caption">{caption}</p>
</div>

<style>
  .growth-chart {
    width: 100%;
  }

  svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .growth-line {
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    transition: stroke-dashoffset 1.2s ease-out;
  }

  .growth-area {
    opacity: 0;
    transition: opacity 0.8s ease-out 0.6s;
  }

  .growth-point {
    opacity: 0;
    transition: opacity 0.3s ease-out;
  }

  .growth-point-start {
    transition-delay: 0.1s;
  }

  .growth-point-end {
    transition-delay: 1.1s;
  }

  .growth-chart.in-view .growth-line {
    stroke-dashoffset: 0;
  }

  .growth-chart.in-view .growth-area {
    opacity: 1;
  }

  .growth-chart.in-view .growth-point {
    opacity: 1;
  }

  .growth-labels {
    display: flex;
    justify-content: space-between;
    color: var(--color-text-dim);
  }

  .growth-label-end {
    color: var(--color-accent);
  }

  .growth-caption {
    margin-top: 16px;
    font-size: 14px;
    color: var(--color-text-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .growth-line {
      stroke-dashoffset: 0;
    }
    .growth-area,
    .growth-point {
      opacity: 1;
    }
  }
</style>

<script>
  const charts = document.querySelectorAll<HTMLElement>('[data-growth-chart]:not([data-chart-bound])');

  if (charts.length > 0) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('in-view');
            observer.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.3 }
    );

    charts.forEach((el) => {
      el.dataset.chartBound = 'true';
      observer.observe(el);
    });
  }
</script>
