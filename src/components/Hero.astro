---
import { Picture } from 'astro:assets';
import pavel1 from '../assets/pavel1.png';
import { heroStats } from '../data/site';
---

<section class="hero" id="hero">
  <div class="hero-inner section">
    <div class="hero-copy">
      <p class="mono-label">Интернет-маркетолог · Ярославль</p>
      <h1 class="hero-title">
        Настраиваю Яндекс.Директ<br />
        и создаю сайты,<br />
        которые продают
      </h1>

      <p class="hero-subtitle">
        Реклама, за которую я отвечаю лично.<br />
        Ни один рубль бюджета не проходит мимо отчёта.
      </p>

      <div class="hero-actions">
        <a href="#contact" class="btn btn-primary">Получить медиаплан</a>
        <a href="#cases" class="btn btn-ghost">Смотреть кейсы</a>
        <a href="https://yaropolov.ru/articles/" class="btn btn-ghost">Статьи</a>
      </div>
    </div>

    <div class="hero-photo-wrap">
      <div class="blueprint-grid hero-blueprint" aria-hidden="true"></div>
      <div class="hero-photo panel">
        <div class="hero-photo-layer hero-photo-sharp">
          <Picture
            src={pavel1}
            formats={['webp']}
            fallbackFormat="jpeg"
            alt="Ярополов Павел, интернет-маркетолог"
            width={640}
            height={800}
            class="hero-photo-img"
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <div class="hero-photo-layer hero-photo-blur">
          <Picture
            src={pavel1}
            formats={['webp']}
            fallbackFormat="jpeg"
            alt=""
            aria-hidden="true"
            width={640}
            height={800}
            class="hero-photo-img hero-photo-img-blur"
            loading="eager"
          />
        </div>
        <div class="hero-photo-layer hero-photo-edge">
          <Picture
            src={pavel1}
            formats={['webp']}
            fallbackFormat="jpeg"
            alt=""
            aria-hidden="true"
            width={640}
            height={800}
            class="hero-photo-img"
            loading="eager"
          />
        </div>
        <div class="hero-photo-grain" aria-hidden="true"></div>
      </div>
      <p class="hero-caption">
        <span class="marginalia" aria-hidden="true">это я →</span>
        Ярополов Павел, 5 лет в маркетинге
      </p>
    </div>
  </div>

  <div class="hero-stats section">
    {heroStats.map((stat) => (
      <div class="hero-stat">
        <p class="hero-stat-value">{stat.value}</p>
        <p class="hero-stat-label mono-label">{stat.label}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: 56px;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 56px;
    align-items: center;
    padding-bottom: 64px;
  }

  @media (min-width: 960px) {
    .hero-inner {
      grid-template-columns: 1.2fr 0.8fr;
      gap: 64px;
    }
  }

  .hero-copy {
    min-width: 0;
  }

  .hero-title {
    font-size: 34px;
    font-weight: 200;
    line-height: 1.08;
    letter-spacing: -0.02em;
    margin-top: 22px;
    max-width: 780px;
    overflow-wrap: break-word;
  }

  @media (min-width: 640px) {
    .hero-title {
      font-size: 52px;
    }
  }

  @media (min-width: 1200px) {
    .hero-title {
      font-size: 68px;
    }
  }

  .hero-subtitle {
    margin-top: 28px;
    font-size: 19px;
    line-height: 1.55;
    color: var(--color-text-muted);
    max-width: 520px;
  }

  .hero-actions {
    margin-top: 40px;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px;
  }

  .hero-photo-wrap {
    position: relative;
    justify-self: center;
    max-width: 400px;
    width: 100%;
  }

  .hero-blueprint {
    position: absolute;
    inset: -12%;
    z-index: -1;
  }

  .hero-photo {
    position: relative;
    aspect-ratio: 4 / 5;
    width: 100%;
    overflow: hidden;
    padding: 0;
  }

  /* Маска и фильтр намеренно на разных элементах: наложение mask-image
     и filter на один и тот же узел иногда не прорисовывается при первом
     заходе на страницу (баг компоновки в части браузеров на Chromium) —
     разнеся их по обёртке и картинке, получаем надёжную отрисовку. */
  .hero-photo-layer {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .hero-photo-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: url(#photo-mono) contrast(1.1);
  }

  .hero-photo-img-blur {
    filter: url(#photo-mono) contrast(1.1);
  }

  .hero-photo-sharp {
    -webkit-mask-image: radial-gradient(ellipse 72% 88% at 50% 40%, black 0%, black 64%, transparent 87%), linear-gradient(to top, black 0%, black 5%, transparent 24%);
    mask-image: radial-gradient(ellipse 72% 88% at 50% 40%, black 0%, black 64%, transparent 87%), linear-gradient(to top, black 0%, black 5%, transparent 24%);
  }

  .hero-photo-blur {
    -webkit-mask-image: radial-gradient(ellipse 72% 82% at 50% 38%, transparent 0%, transparent 58%, black 72%, black 84%, transparent 96%);
    mask-image: radial-gradient(ellipse 72% 82% at 50% 38%, transparent 0%, transparent 58%, black 72%, black 84%, transparent 96%);
  }

  /* Отдельный резкий слой поверх всего — гарантирует небольшую нерасплывчатую
     полосу у самого нижнего края, независимо от того, что творится с блюром выше. */
  .hero-photo-edge {
    -webkit-mask-image: linear-gradient(to top, black 0%, black 6%, transparent 16%);
    mask-image: linear-gradient(to top, black 0%, black 6%, transparent 16%);
  }

  /* Плёночное зерно поверх фото — генерируется SVG-турбулентностью,
     а не текстурной картинкой, чтобы не тянуть лишний файл и не
     размножать его на каждое фото на сайте. */
  .hero-photo-grain {
    position: absolute;
    inset: 0;
    filter: url(#photo-grain);
    mix-blend-mode: overlay;
    opacity: 0.22;
    pointer-events: none;
  }

  .hero-caption {
    margin-top: 16px;
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.02em;
    color: var(--color-text-dim);
  }

  .hero-stats {
    display: grid;
    grid-template-columns: 1fr;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  @media (min-width: 1024px) {
    .hero-stats {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .hero-stat {
    padding-block: 20px;
    border-top: 1px solid var(--color-border);
  }

  .hero-stat:first-child {
    border-top: none;
  }

  @media (min-width: 1024px) {
    .hero-stat {
      padding-block: 32px;
      padding-left: 24px;
      border-top: none;
      border-left: 1px solid var(--color-border);
    }

    .hero-stat:first-child {
      border-left: none;
      padding-left: 0;
    }
  }

  .hero-stat-value {
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 24px;
    color: var(--color-text);
    white-space: nowrap;
  }

  @media (min-width: 640px) {
    .hero-stat-value {
      font-size: 30px;
    }
  }

  @media (min-width: 1024px) {
    .hero-stat-value {
      font-size: 38px;
    }
  }

  .hero-stat-label {
    margin-top: 8px;
    white-space: nowrap;
  }
</style>
