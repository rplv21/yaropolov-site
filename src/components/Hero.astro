---
import { Picture } from 'astro:assets';
import pavel1 from '../assets/pavel1.png';
import { heroStats } from '../data/site';
---

<section class="hero" id="hero">
  <div class="hero-spread">
    <div class="hero-copy">
      <p class="mono-label hero-kicker">Интернет-маркетолог · Ярославль</p>
      <h1 class="hero-title">
        <span class="hero-lead">Настраиваю Яндекс.Директ<br />и создаю сайты,</span>
        <span class="hero-giant">
          <span class="hero-giant-line">которые</span>
          <span class="hero-giant-line hero-giant-red">продают</span>
        </span>
      </h1>

      <div class="hero-foot">
        <p class="hero-subtitle">
          Реклама, за которую я отвечаю лично.<br />
          Ни один рубль бюджета не проходит мимо отчёта.
        </p>
        <div class="hero-actions">
          <a href="#contact" class="btn btn-primary">Получить медиаплан</a>
          <a href="#cases" class="btn btn-ghost">Смотреть кейсы</a>
          <a href="https://yaropolov.ru/articles/" class="btn btn-ghost">Статьи</a>
        </div>
      </div>
    </div>

    <figure class="hero-photo">
      <Picture
        src={pavel1}
        formats={['webp']}
        fallbackFormat="jpeg"
        alt="Ярополов Павел, интернет-маркетолог"
        width={900}
        height={1125}
        class="hero-photo-img"
        loading="eager"
        fetchpriority="high"
      />
      <div class="hero-photo-grain" aria-hidden="true"></div>
      <figcaption class="hero-caption">
        <span class="marginalia" aria-hidden="true">это я</span>
        Ярополов Павел, 5 лет в маркетинге
      </figcaption>
    </figure>
  </div>

  <div class="hero-stats-band">
    <div class="hero-stats section">
      {heroStats.map((stat) => (
        <div class="hero-stat">
          <p class="hero-stat-value">{stat.value}</p>
          <p class="hero-stat-label mono-label">{stat.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: 32px;
    overflow-x: clip;
  }

  /* Разворот: текст слева, фото вплотную к правому краю экрана. Гигантские
     слова заходят на фото — приём журнальных разворотов. */
  .hero-spread {
    display: grid;
    grid-template-columns: 1fr;
  }

  @media (min-width: 960px) {
    .hero-spread {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.62fr);
      min-height: min(820px, calc(100dvh - 140px));
    }
  }

  .hero-copy {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 36px;
    padding: 24px 20px 40px;
    min-width: 0;
  }

  @media (min-width: 960px) {
    .hero-copy {
      padding: 24px 0 48px max(40px, calc((100vw - var(--page-max)) / 2 + 40px));
    }
  }

  .hero-title {
    margin: 0;
    font-weight: 200;
    letter-spacing: -0.02em;
  }

  .hero-lead {
    display: block;
    font-size: clamp(20px, 2.1vw, 32px);
    line-height: 1.2;
    font-weight: 300;
    color: var(--color-text-muted);
    margin-bottom: 14px;
  }

  .hero-giant {
    display: block;
    font-family: var(--font-poster);
    font-weight: 700;
    text-transform: uppercase;
    font-size: clamp(72px, 21vw, 250px);
    line-height: 0.84;
    letter-spacing: -0.01em;
    width: max-content;
  }

  @media (min-width: 960px) {
    .hero-giant {
      font-size: clamp(76px, 15.5vw, 250px);
    }
  }

  .hero-giant-line {
    display: block;
  }

  .hero-giant-red {
    color: var(--color-accent);
  }

  .hero-foot {
    display: grid;
    gap: 28px;
    max-width: 560px;
  }

  .hero-subtitle {
    font-size: 18px;
    line-height: 1.55;
    color: var(--color-text-muted);
  }

  .hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
  }

  .hero-photo {
    position: relative;
    margin: 0;
    min-height: 460px;
    overflow: hidden;
    background: var(--color-surface);
  }

  /* Красный квадрат в углу — метка из баухаус-языка сайта */
  .hero-photo::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 56px;
    height: 56px;
    background: var(--color-accent);
    z-index: 3;
  }

  .hero-photo-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 18%;
    filter: url(#photo-mono) contrast(1.15);
  }

  .hero-photo-grain {
    position: absolute;
    inset: 0;
    filter: url(#photo-grain);
    mix-blend-mode: overlay;
    opacity: 0.22;
    pointer-events: none;
  }

  .hero-caption {
    position: absolute;
    left: 20px;
    bottom: 16px;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px 10px;
    background: var(--color-canvas);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.02em;
    color: var(--color-text-muted);
  }

  /* Полоса статистики — на всю ширину экрана, от края до края: линии и
     заливка идут за пределы контейнера, а сами цифры остаются в его сетке. */
  .hero-stats-band {
    background: var(--color-surface);
    border-top: 1px solid var(--color-border-strong);
    border-bottom: 1px solid var(--color-border-strong);
  }

  .hero-stats {
    display: grid;
    grid-template-columns: 1fr;
  }

  @media (min-width: 1024px) {
    .hero-stats {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .hero-stat {
    padding-block: 20px;
    border-top: 1px solid var(--color-border);
  }

  .hero-stat:first-child {
    border-top: none;
  }

  @media (min-width: 1024px) {
    .hero-stat {
      padding-block: 32px;
      padding-left: 24px;
      border-top: none;
      border-left: 1px solid var(--color-border);
    }

    .hero-stat:first-child {
      border-left: none;
      padding-left: 0;
    }
  }

  .hero-stat-value {
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 24px;
    color: var(--color-text);
    white-space: nowrap;
  }

  @media (min-width: 640px) {
    .hero-stat-value {
      font-size: 30px;
    }
  }

  @media (min-width: 1024px) {
    .hero-stat-value {
      font-size: 38px;
    }
  }

  .hero-stat-label {
    margin-top: 8px;
    white-space: nowrap;
  }
</style>
