---
export const prerender = false;

// Карточка заявки. Заявка хранится в базе на TimeWeb (РФ); в Telegram приходит
// только ссылка сюда. Токен — 128 бит случайности, страница закрыта от поисковиков.
import AvLayout from '../../layouts/AvLayout.astro';
import { db, hasDb } from '../../lib/db';

const token = Astro.params.token ?? '';
if (!/^[A-Za-z0-9_-]{22}$/.test(token) || !hasDb()) return new Response(null, { status: 404 });

type Lead = {
  createdAt: string;
  source: string;
  suspicious: boolean;
  ab: { ms: number; n: number };
  fields: Record<string, string>;
};
let lead: Lead | null = null;
try {
  const s = await db();
  const rows = await s<{ data: Lead }[]>`select data from leads where token = ${token}`;
  lead = rows[0]?.data ?? null;
} catch (e) {
  console.error('База заявок недоступна:', e);
}
if (!lead) return new Response(null, { status: 404 });

Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
Astro.response.headers.set('Cache-Control', 'no-store');

const f = lead.fields;
const date = new Date(lead.createdAt).toLocaleString('ru-RU', { timeZone: 'Europe/Moscow', dateStyle: 'long', timeStyle: 'short' });
const rows = [
  ['Способ связи', f.method],
  ['Контакт', f.contact],
  ['Телефон', f.extraPhone],
  ['Почта', f.email],
  ['Сайт', f.site],
  ['Ниша', f.niche],
  ['Комментарий', f.comment],
].filter(([, v]) => v);
---

<AvLayout title={`Заявка: ${f.name}`} noindex noChat>
  <header class="lh">
    <div class="wrap">
      <p class="mono lh-tag">Заявка от {date}{lead.source ? ` · ${lead.source}` : ''}</p>
      <h1 class="giant lh-h">{f.name}</h1>
      {lead.suspicious && (
        <p class="mono lh-bot">Похоже на бота: {Math.round(lead.ab.ms / 1000)} с на странице, нажатий: {lead.ab.n}</p>
      )}
      <dl class="lh-sum">
        {rows.map(([k, v]) => (
          <div>
            <dt class="mono">{k}</dt>
            <dd>{v}</dd>
          </div>
        ))}
      </dl>
    </div>
  </header>
</AvLayout>

<style>
  .lh {
    min-height: 100svh;
    padding-top: calc(var(--mast) + clamp(40px, 6vw, 96px));
    padding-bottom: clamp(40px, 6vw, 88px);
  }
  .lh-tag {
    color: #cfc8b4;
  }
  .lh-h {
    margin-top: clamp(16px, 2.4vw, 32px);
    max-width: 18ch;
    font-size: clamp(36px, 7vw, 120px);
    overflow-wrap: anywhere;
  }
  .lh-bot {
    margin-top: 16px;
    color: var(--red);
  }
  .lh-sum {
    display: grid;
    gap: 20px;
    max-width: 760px;
    margin-top: clamp(28px, 4vw, 56px);
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .lh-sum dt {
    color: #a09882;
    margin-bottom: 6px;
  }
  .lh-sum dd {
    margin: 0;
    font-size: clamp(17px, 1.5vw, 22px);
    font-weight: 300;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
</style>
