---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import PrivacyContent from '../components/PrivacyContent.astro';
---

<Layout
  title="Политика конфиденциальности — yaropolov.ru"
  description="Политика обработки персональных данных на сайте yaropolov.ru."
>
  <section class="section section-gap privacy">
    <h1 class="privacy-title">Политика конфиденциальности</h1>
    <p class="privacy-updated">Действует с 2026 года</p>

    <div class="privacy-page-body">
      <PrivacyContent />
    </div>
  </section>
</Layout>

<style>
  .privacy {
    max-width: 760px;
  }

  .privacy-title {
    font-size: 36px;
  }

  @media (min-width: 640px) {
    .privacy-title {
      font-size: 48px;
    }
  }

  .privacy-updated {
    margin-top: 12px;
    font-family: var(--font-mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-dim);
  }

  .privacy-page-body {
    margin-top: 40px;
  }
</style>
