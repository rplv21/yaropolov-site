---
export const prerender = true;

import AvLayout from '../../layouts/AvLayout.astro';
import Contact from '../../components/av/Contact.astro';
import { articles } from '../../data/articles';
import type { Article } from '../../data/articles';

export function getStaticPaths() {
  return articles.map((article, i) => ({
    params: { slug: article.slug },
    props: { article, next: articles[(i + 1) % articles.length] },
  }));
}

interface Props {
  article: Article;
  next: Article;
}

const { article, next } = Astro.props;
const canonical = `https://yaropolov.ru/articles/${article.slug}`;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.title,
  description: article.description,
  datePublished: article.datePublished,
  mainEntityOfPage: canonical,
  author: { '@type': 'Person', name: 'Ярополов Павел Алексеевич' },
  publisher: { '@type': 'Person', name: 'Ярополов Павел Алексеевич' },
};
---

<AvLayout title={`${article.title} — Ярополов Павел`} description={article.description}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  </Fragment>

  <header class="ahd">
    <div class="wrap">
      <nav class="mono crumbs" aria-label="Хлебные крошки">
        <a href="/">Главная</a>
        <span aria-hidden="true">/</span>
        <a href="/articles">Статьи</a>
      </nav>

      <h1 class="giant ahd-h" data-split>{article.title}</h1>
      <p class="mono ahd-date">{article.dateDisplay}</p>
    </div>
  </header>

  <article class="abody" data-article-scroll-goal>
    <div class="wrap abody-grid">
      <aside class="abody-side mono" aria-hidden="true">
        <span class="abody-mark"></span>
        Статья
      </aside>

      <div class="abody-text">
        {article.body.map((block) => (block.type === 'h2' ? <h2>{block.text}</h2> : <p set:html={block.html} />))}

        <div class="author">
          <p class="mono author-tag">Автор</p>
          <p class="author-name">Ярополов Павел</p>
          <p class="author-text">
            Интернет-маркетолог. Настраиваю Яндекс.Директ и создаю сайты для бизнеса.
          </p>
          <div class="author-links">
            <a href="/#about" class="author-link">Обо мне</a>
            <a href="#contact" class="author-link">Написать</a>
          </div>
        </div>
      </div>
    </div>
  </article>

  <aside class="next" aria-label="Следующая статья">
    <div class="wrap">
      <p class="mono">Читать дальше</p>
      <a href={`/articles/${next.slug}`} class="next-link">
        <span class="next-title">{next.title}</span>
        <span class="next-arrow" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" focusable="false">
            <path d="M5 19 19 5M8 5h11v11" stroke="currentColor" stroke-width="1.4" stroke-linecap="square" />
          </svg>
        </span>
      </a>
    </div>
  </aside>

  <Contact />
</AvLayout>

<style>
  .ahd {
    padding-top: calc(var(--mast) + clamp(32px, 5vw, 80px));
    padding-bottom: clamp(48px, 6vw, 96px);
  }

  .crumbs {
    display: flex;
    gap: 12px;
    color: var(--dim);
  }

  .crumbs a {
    transition: color 0.2s ease;
  }

  .crumbs a:hover {
    color: var(--red);
  }

  .ahd-h {
    margin-top: clamp(24px, 3vw, 48px);
    max-width: 18ch;
    font-size: clamp(34px, 6.2vw, 116px);
  }

  .ahd-date {
    margin-top: clamp(24px, 3vw, 48px);
    color: var(--dim);
  }

  /* Тело статьи на бумаге: длинный текст читается лучше светлым */
  .abody {
    background: var(--paper);
    color: var(--ink);
    padding-block: clamp(56px, 8vw, 128px);
  }

  .abody-grid {
    display: grid;
    gap: 28px;
  }

  @media (min-width: 1000px) {
    .abody-grid {
      grid-template-columns: 3fr 8fr;
      column-gap: clamp(32px, 4vw, 72px);
    }
  }

  .abody-side {
    display: flex;
    align-items: center;
    gap: 14px;
    align-self: start;
    color: #6b6556;
    position: sticky;
    top: calc(var(--mast) + 24px);
  }

  .abody-mark {
    width: 10px;
    height: 10px;
    background: var(--red);
  }

  .abody-text {
    max-width: 70ch;
    display: grid;
    gap: 22px;
  }

  .abody-text :global(h2) {
    margin-top: clamp(20px, 3vw, 44px);
    font-weight: 200;
    font-size: clamp(28px, 3.4vw, 54px);
    line-height: 1.05;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .abody-text :global(p) {
    font-size: clamp(17px, 1.3vw, 20px);
    line-height: 1.7;
    color: #2a261f;
  }

  .abody-text :global(strong) {
    font-weight: 600;
    color: var(--ink);
  }

  .abody-text :global(a) {
    border-bottom: 1.5px solid var(--red);
    transition: color 0.2s ease;
  }

  .abody-text :global(a:hover) {
    color: var(--red);
  }

  .author {
    margin-top: clamp(32px, 5vw, 72px);
    padding-top: 24px;
    border-top: 1px solid var(--ink);
    display: grid;
    gap: 10px;
  }

  /* Селекторы с .abody-text перебивают общие стили абзацев статьи */
  .abody-text .author-tag {
    font-size: 12px;
    line-height: 1.4;
    color: #6b6556;
  }

  .abody-text .author-name {
    font-weight: 200;
    font-size: clamp(30px, 3.6vw, 56px);
    letter-spacing: -0.05em;
    line-height: 1;
    color: var(--ink);
  }

  .abody-text .author-text {
    max-width: 44ch;
    font-size: 16px;
    line-height: 1.55;
  }

  .author-links {
    margin-top: 6px;
    display: flex;
    gap: 24px;
  }

  .abody-text .author-link {
    font-weight: 600;
    font-size: 15px;
  }

  .next {
    background: var(--red);
    color: var(--ink);
    padding-block: clamp(48px, 7vw, 112px);
  }

  .next-link {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-top: 20px;
  }

  .next-title {
    max-width: 22ch;
    font-weight: 200;
    font-size: clamp(30px, 5.2vw, 96px);
    line-height: 1;
    letter-spacing: -0.05em;
    text-wrap: balance;
    transition: transform 0.5s var(--ease);
  }

  .next-arrow {
    flex-shrink: 0;
    width: clamp(64px, 8vw, 128px);
    height: clamp(64px, 8vw, 128px);
    display: grid;
    place-items: center;
    border: 1px solid var(--ink);
    border-radius: 50%;
    transition: transform 0.5s var(--ease), background 0.3s ease, color 0.3s ease;
  }

  .next-arrow svg {
    width: 45%;
    height: 45%;
  }

  @media (hover: hover) and (pointer: fine) {
    .next-link:hover .next-title {
      transform: translateX(12px);
    }

    .next-link:hover .next-arrow {
      transform: rotate(45deg);
      background: var(--ink);
      color: var(--red);
    }
  }
</style>

<script>
  // Цель в Метрике на глубину прокрутки статьи: фиксируем один раз за визит.
  const article = document.querySelector('[data-article-scroll-goal]');
  if (article) {
    let fired = false;
    function checkDepth() {
      if (fired) return;
      const rect = article!.getBoundingClientRect();
      const total = rect.height;
      const scrolled = Math.min(total, window.innerHeight - rect.top);
      if (total > 0 && scrolled / total >= 0.75) {
        fired = true;
        try {
          if (typeof (window as any).ym === 'function') {
            (window as any).ym(112339088, 'reachGoal', 'article_scroll_75');
          }
        } catch {
          /* аналитика не должна ронять страницу */
        }
        window.removeEventListener('scroll', checkDepth);
      }
    }
    window.addEventListener('scroll', checkDepth, { passive: true });
    checkDepth();
  }
</script>
