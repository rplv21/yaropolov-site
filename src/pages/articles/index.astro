---
export const prerender = true;

import AvLayout from '../../layouts/AvLayout.astro';
import { articles } from '../../data/articles';

// По умолчанию подборка «Рекомендуем»; остальные порядки переключает скрипт ниже
const sorted = [...articles].sort(
  (a, b) => (a.featured ?? 99) - (b.featured ?? 99) || b.datePublished.localeCompare(a.datePublished)
);
---

<AvLayout
  title="Статьи — Ярополов Павел"
  description="Разборы про рекламу в Яндекс.Директе и сайты для бизнеса: сколько стоит реклама, почему она иногда не работает и когда сайту пора вырасти из конструктора."
>
  <section class="ahead">
    <div class="wrap">
      <p class="mono tag">Статьи</p>
      <h1 class="giant ahead-h" data-split>Разборы про рекламу<br />и <em>сайты</em> для бизнеса</h1>
    </div>
  </section>

  <section class="alist" aria-label="Список статей">
    <div class="wrap">
      <div class="sort" role="tablist" aria-label="Порядок статей">
        <button type="button" class="sort-btn mono is-on" role="tab" aria-selected="true" data-sort="featured">Рекомендуем</button>
        <button type="button" class="sort-btn mono" role="tab" aria-selected="false" data-sort="new">Сначала новые</button>
        <button type="button" class="sort-btn mono" role="tab" aria-selected="false" data-sort="old">Сначала старые</button>
      </div>
      <p class="sort-note mono" id="sort-note" role="status" hidden></p>

      <ul id="alist">
        {
          sorted.map((a) => (
            <li data-slug={a.slug} data-date={a.datePublished} data-rank={a.featured ?? 99}>
              <a href={`/articles/${a.slug}`} class="arow">
                <p class="mono arow-date">{a.dateDisplay}</p>
                <div class="arow-main">
                  <h2 class="arow-title">{a.title}</h2>
                  <p class="arow-excerpt">{a.excerpt}</p>
                </div>
                <span class="arow-go" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" focusable="false">
                    <path d="M5 19 19 5M8 5h11v11" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" />
                  </svg>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</AvLayout>

<style>
  .sort {
    display: inline-flex;
    flex-wrap: wrap;
    margin-bottom: clamp(20px, 3vw, 40px);
    border: 1px solid var(--line);
  }

  .sort-btn {
    padding: 14px 22px;
    background: transparent;
    border: 0;
    color: var(--dim);
    cursor: pointer;
    transition: background 0.25s ease, color 0.25s ease;
  }

  .sort-btn.is-on {
    background: var(--paper);
    color: var(--ink);
  }

  .sort-btn:focus-visible {
    outline: 2px solid var(--red);
    outline-offset: 2px;
  }

  @media (hover: hover) and (pointer: fine) {
    .sort-btn:not(.is-on):hover {
      color: var(--paper);
    }
  }

  /* Телефон: три кнопки в одну строку на всю ширину */
  @media (max-width: 639px) {
    .sort {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      width: 100%;
    }

    .sort-btn {
      padding: 14px 4px;
      font-size: 10px;
      letter-spacing: 0.06em;
      text-align: center;
    }
  }

  .sort-note {
    margin: 0 0 24px;
    color: var(--dim);
  }

  .ahead {
    padding-top: calc(var(--mast) + clamp(40px, 6vw, 96px));
    padding-bottom: clamp(40px, 6vw, 96px);
  }

  .ahead-h {
    margin-top: clamp(20px, 3vw, 40px);
    font-size: clamp(40px, 8.2vw, 156px);
  }

  .alist {
    padding-bottom: clamp(72px, 10vw, 160px);
  }

  .alist ul {
    border-top: 1px solid var(--line);
  }

  .arow {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 14px;
    padding: clamp(24px, 3vw, 44px) clamp(12px, 2vw, 32px);
    border-bottom: 1px solid var(--line);
    transition: background 0.35s var(--ease), color 0.35s var(--ease), padding 0.45s var(--ease);
  }

  @media (min-width: 900px) {
    .arow {
      grid-template-columns: 200px minmax(0, 1fr) 56px;
      column-gap: clamp(24px, 3vw, 56px);
      align-items: start;
    }
  }

  .arow-date {
    color: var(--dim);
    padding-top: 0.8em;
    transition: color 0.35s ease;
  }

  .arow-title {
    font-weight: 200;
    font-size: clamp(26px, 3.4vw, 58px);
    line-height: 1.05;
    letter-spacing: -0.045em;
    max-width: 22ch;
    text-wrap: balance;
  }

  .arow-excerpt {
    margin-top: 16px;
    max-width: 62ch;
    color: #ddd6c1;
    font-size: clamp(15px, 1.2vw, 18px);
    line-height: 1.55;
    transition: color 0.35s ease;
  }

  .arow-go {
    display: grid;
    place-items: center;
    justify-self: end;
    width: 56px;
    height: 56px;
    border: 1px solid currentColor;
    border-radius: 50%;
    transition: transform 0.5s var(--ease), background 0.3s ease, color 0.3s ease;
  }

  .arow-go svg {
    width: 22px;
    height: 22px;
  }

  @media (hover: hover) and (pointer: fine) {
    .arow:hover {
      background: var(--red);
      color: var(--ink);
    }

    .arow:hover .arow-date,
    .arow:hover .arow-excerpt {
      color: var(--ink);
    }

    .arow:hover .arow-go {
      transform: rotate(45deg);
      background: var(--ink);
      color: var(--paper);
      border-color: var(--ink);
    }
  }
</style>

<script>
  const list = document.getElementById('alist') as HTMLUListElement;
  const note = document.getElementById('sort-note') as HTMLElement;
  const btns = Array.from(document.querySelectorAll<HTMLButtonElement>('.sort-btn'));
  const items = Array.from(list.querySelectorAll<HTMLLIElement>('li'));
  const byDate = (a: HTMLLIElement, b: HTMLLIElement) => (b.dataset.date || '').localeCompare(a.dataset.date || '');
  const byRank = (x: HTMLLIElement, y: HTMLLIElement) => Number(x.dataset.rank) - Number(y.dataset.rank) || byDate(x, y);

  const render = (arr: HTMLLIElement[]) => arr.forEach((li) => list.appendChild(li));

  function apply(mode: string) {
    note.hidden = true;
    if (mode === 'old') return render([...items].sort((x, y) => -byDate(x, y)));
    if (mode === 'featured') return render([...items].sort(byRank));
    render([...items].sort(byDate));
  }

  btns.forEach((b) =>
    b.addEventListener('click', () => {
      btns.forEach((x) => {
        const on = x === b;
        x.classList.toggle('is-on', on);
        x.setAttribute('aria-selected', String(on));
      });
      apply(b.dataset.sort || 'new');
    })
  );
</script>
