---
export const prerender = true;

import AvLayout from '../layouts/AvLayout.astro';
---

<AvLayout
  title="Страница не найдена — Ярополов Павел"
  description="Такой страницы на сайте нет. Вернитесь на главную или загляните в статьи."
  noindex
>
  <section class="nf">
    <div class="wrap">
      <p class="mono tag">Ошибка 404</p>
      <p class="nf-code" aria-hidden="true">404</p>
      <h1 class="giant nf-h" data-split>Такой страницы <em>нет</em></h1>
      <p class="nf-text">Ссылка устарела или в адресе опечатка. Начните с главной, оттуда всё находится.</p>
      <div class="nf-actions">
        <a href="/" class="btn btn--red" data-mag>На главную</a>
        <a href="/articles" class="btn" data-mag>Статьи</a>
      </div>
    </div>
  </section>
</AvLayout>

<style>
  .nf {
    min-height: 100dvh;
    display: flex;
    align-items: center;
    padding: calc(var(--mast) + 40px) 0 80px;
  }

  .nf .wrap {
    width: 100%;
  }

  .nf-code {
    margin-top: clamp(16px, 3vw, 40px);
    font-weight: 200;
    font-size: clamp(120px, 30vw, 520px);
    line-height: 0.8;
    letter-spacing: -0.07em;
    color: var(--red);
  }

  .nf-h {
    margin-top: clamp(20px, 3vw, 44px);
    font-size: clamp(34px, 6vw, 112px);
  }

  .nf-text {
    margin-top: 20px;
    max-width: 46ch;
    color: #cfc8b4;
  }

  .nf-actions {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
</style>
